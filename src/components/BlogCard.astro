---
import { asset } from '../data/assets';
import { blogCategorySlug, formatBlogDate } from '../utils/blog';

interface BlogPostCard {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  featured_image?: string | null;
  image_alt?: string | null;
  published_at: string;
  reading_time: number;
}

const { post, featured = false } = Astro.props as { post: BlogPostCard; featured?: boolean };
const image = post.featured_image
  ? post.featured_image.startsWith('http')
    ? post.featured_image
    : asset(post.featured_image)
  : '';
const categoryUrl = `/blog/category/${blogCategorySlug(post.category)}/`;
---

<article class={`blog-card group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl hover:border-[#00529B]/40 transition-all flex flex-col ${featured ? 'lg:flex-row' : ''}`}>
  <a href={`/blog/${post.slug}/`} class={`block bg-gray-100 overflow-hidden ${featured ? 'lg:w-1/2' : ''}`} tabindex="-1" aria-hidden="true">
    {image ? (
      <img
        src={image}
        alt={post.image_alt || post.title}
        width="1200"
        height="800"
        class={`w-full object-cover group-hover:scale-[1.03] transition-transform duration-500 ${featured ? 'h-64 lg:h-[360px]' : 'h-48'}`}
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class={`w-full bg-gradient-to-br from-blue-50 to-slate-100 flex items-center justify-center ${featured ? 'h-64 lg:h-[360px]' : 'h-48'}`}>
        <span class="text-4xl" aria-hidden="true">🌦️</span>
      </div>
    )}
  </a>

  <div class={`p-5 md:p-6 flex flex-col flex-1 ${featured ? 'lg:w-1/2 lg:justify-center' : ''}`}>
    <div class="flex flex-wrap items-center gap-2 text-xs mb-3">
      <a href={categoryUrl} class="px-2.5 py-1 bg-blue-50 text-[#00529B] rounded-full font-semibold hover:bg-blue-100 transition-colors">
        {post.category}
      </a>
    </div>

    <h2 class={`font-bold text-gray-900 group-hover:text-[#00529B] transition-colors leading-snug ${featured ? 'text-2xl md:text-3xl mb-3' : 'text-xl mb-2'}`}>
      <a href={`/blog/${post.slug}/`}>{post.title}</a>
    </h2>

    <p class={`text-gray-600 text-sm leading-relaxed ${featured ? 'mb-5 line-clamp-3' : 'mb-4 line-clamp-3'}`}>
      {post.excerpt}
    </p>

    <div class="mt-auto flex items-center justify-between gap-3 text-xs text-gray-500">
      <time datetime={post.published_at}>{formatBlogDate(post.published_at)}</time>
      <span>{post.reading_time} min read</span>
    </div>
  </div>
</article>
