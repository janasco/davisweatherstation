---
import Layout from '../layouts/Layout.astro';
import { resellers, countries } from '../data/resellers';
import { allProducts } from '../data/allProducts';
import { faqs } from '../data/faqs';
import { getFeaturedResellers } from '../utils/resellerRotation';

const featuredResellers = getFeaturedResellers(6);
const featuredProducts = allProducts.filter((product) => product.curated).slice(0, 4);
---

<Layout title="Davis Instruments Weather Stations & Authorized Resellers" description="Find authorized Davis Instruments resellers worldwide, explore the full product catalog, and build your weather station with the Smart Buying Guide.">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-[#00529B] to-[#003d73] text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Find Davis Instruments Resellers Worldwide
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-blue-100">
          Discover authorized dealers and explore the complete line of professional weather monitoring solutions.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/guide/" class="btn-shimmer bg-[#C2410C] hover:bg-[#9a3412] text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all text-center shadow-xl hover:shadow-xl">
            Smart Buying Guide
          </a>
          <a href="/resellers/" class="btn-shimmer bg-white/10 hover:bg-white/20 backdrop-blur text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all text-center border border-white/30 shadow-xl hover:shadow-xl">
            Browse Resellers
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-[#00529B] mb-2">{resellers.length}</div>
          <div class="text-gray-600 font-medium">Authorized Resellers</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-[#00529B] mb-2">{countries.length}</div>
          <div class="text-gray-600 font-medium">Countries</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-[#00529B] mb-2">{allProducts.length}</div>
          <div class="text-gray-600 font-medium">Weather Products</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Resellers -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center mb-6">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-2">Featured Resellers</h2>
        </div>
        <a href="/resellers/" class="hidden md:inline-flex items-center text-[#00529B] hover:text-[#003d73] font-semibold">
          View All Resellers →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredResellers.map((reseller) => (
          <a href={`/resellers/${reseller.slug}/`} class="bg-white border border-gray-200 rounded-xl p-6 hover:shadow-xl hover:border-[#00529B]/30 transition-all group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-20 h-20 bg-gradient-to-br from-[#C2410C]/10 to-transparent rounded-bl-full"></div>
            <div class="flex items-start justify-between mb-3 relative">
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-[#00529B] transition-colors flex-1 pr-2">{reseller.name}</h3>
              <span class="px-3 py-1 bg-blue-50 text-[#00529B] text-sm rounded-full font-medium whitespace-nowrap">{reseller.country}</span>
            </div>
            {reseller.resellerSince && (
              <p class="text-xs text-gray-500 mb-2 relative">Est. {reseller.resellerSince}</p>
            )}
            {reseller.description && (
              <p class="text-gray-600 text-sm mb-3 line-clamp-2 relative">{reseller.description}</p>
            )}
            {reseller.services && (
              <p class="text-gray-600 text-sm mb-4 line-clamp-2 relative">{reseller.services}</p>
            )}
            <div class="text-[#00529B] font-medium text-sm group-hover:underline relative">
              View Details →
            </div>
          </a>
        ))}
      </div>
      <div class="mt-4 text-center md:hidden">
        <a href="/resellers/" class="inline-flex items-center text-[#00529B] hover:text-[#003d73] font-semibold">
          View All Resellers →
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center mb-10">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Davis Weather Products</h2>
          <p class="text-xl text-gray-600">Professional-grade weather monitoring equipment</p>
        </div>
        <a href="/products/" class="hidden md:inline-flex items-center text-[#00529B] hover:text-[#003d73] font-semibold">
          View All Products →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <a href={`/products/${product.slug}/`} class="bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-shadow group">
            <div class="h-48 bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center overflow-hidden">
              {product.image ? (
                <img
                  src={product.image}
                  srcset={`${product.image.replace('.webp', '-400.webp')} 400w, ${product.image} 900w`}
                  sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 92vw"
                  alt={product.name}
                  class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-300"
                  loading="lazy" decoding="async"
                />
              ) : (
                <svg class="w-20 h-20 text-[#00529B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                </svg>
              )}
            </div>
            <div class="p-5">
              <span class="text-xs font-semibold text-[#C2410C] uppercase tracking-wide">{product.category}</span>
              <h3 class="text-lg font-bold text-gray-900 mt-2 mb-2 group-hover:text-[#00529B] transition-colors">{product.name}</h3>
              <p class="text-gray-600 text-sm line-clamp-2 mb-3">{product.description}</p>
              <div class="text-[#00529B] font-medium text-sm group-hover:underline">
                Learn More →
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center md:hidden">
        <a href="/products/" class="inline-flex items-center text-[#00529B] hover:text-[#003d73] font-semibold">
          View All Products →
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">Common Questions</h2>
        <p class="text-lg text-gray-600">Quick answers from our <a href="/faq/" class="text-[#00529B] font-semibold hover:underline">full FAQ library</a></p>
      </div>
      <div class="space-y-3">
        {faqs
          .filter((f) => ['which-product', 'vue-vs-pro2', 'find-reseller', 'buy-direct', 'weatherlink-cost', 'warranty'].includes(f.id))
          .map((faq) => (
            <details class="group bg-white border-2 border-gray-100 rounded-2xl shadow-sm hover:shadow-md hover:border-[#00529B]/30 transition-all overflow-hidden">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 select-none">
                <h3 class="font-semibold text-gray-900 group-hover:text-[#00529B] transition-colors text-base">{faq.question}</h3>
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-50 text-[#00529B] flex items-center justify-center transition-all duration-300 group-open:rotate-180 group-open:bg-[#00529B] group-open:text-white">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="px-5 pb-5 text-gray-600 leading-relaxed text-sm" set:html={faq.answer} />
            </details>
          ))}
      </div>
      <div class="text-center mt-8">
        <a href="/faq/" class="inline-flex items-center px-6 py-3 bg-white border-2 border-[#00529B] text-[#00529B] hover:bg-[#00529B] hover:text-white rounded-xl font-semibold transition-all shadow-md hover:shadow-lg">
          View All {faqs.length} FAQs
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-[#00529B] to-[#003d73] rounded-2xl p-8 md:p-12 text-center text-white">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to Get Started?</h2>
        <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
          Find an authorized Davis Instruments reseller near you and start monitoring your weather with professional precision.
        </p>
        <a href="/resellers/" class="inline-block bg-[#C2410C] hover:bg-[#9a3412] text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors">
          Find a Reseller Near You
        </a>
      </div>
    </div>
  </section>
</Layout>
