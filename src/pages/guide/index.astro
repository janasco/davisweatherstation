---
import Layout from '../../layouts/Layout.astro';
import { allProducts } from '../../data/allProducts';
import { resellers } from '../../data/resellers';

const productIndex = allProducts.map((p) => ({
  slug: p.slug,
  name: p.name,
  image: p.image || '',
  sku: p.sku || '',
  category: p.category,
}));

const resellerIndex = resellers
  .filter((r) => r.email)
  .map((r) => ({
    slug: r.slug,
    name: r.name,
    country: r.country,
    city: r.city || '',
  }));
---

<Layout title="Smart Buying Guide" description="Answer seven simple questions and get a tailored Davis Instruments weather station configuration with real products and a ready-to-send quote request.">
  <section class="py-10 bg-gradient-to-br from-slate-50 via-blue-50 to-white min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero -->
      <div class="text-center mb-10">
        <div class="inline-flex items-center px-4 py-2 bg-blue-100 text-[#00529B] rounded-full text-sm font-semibold mb-4">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          Smart Configuration Assistant
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 bg-gradient-to-r from-[#00529B] to-[#003d73] bg-clip-text text-transparent">
          Find Your Weather Station
        </h1>
        <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto mb-5">
          Seven quick questions. One tailored system. Real products, expert guidance, and a quote you can send in one click.
        </p>
        <button id="quick-start" class="inline-flex items-center text-sm font-semibold text-[#00529B] hover:text-[#003d73] underline underline-offset-4">
          In a hurry? Show a popular home setup →
        </button>
      </div>

      <div class="lg:grid lg:grid-cols-[250px_1fr] lg:gap-8">
        <!-- Progress rail -->
        <aside class="hidden lg:block">
          <div class="sticky top-24 bg-white border-2 border-gray-100 rounded-2xl shadow-lg p-5">
            <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Your progress</h2>
            <ol id="step-rail" class="space-y-1"></ol>
            <div class="mt-5 pt-4 border-t border-gray-100">
              <div class="flex items-center justify-between text-xs text-gray-500 mb-1.5">
                <span>Completion</span>
                <span id="rail-percent" class="font-semibold text-[#00529B]">0%</span>
              </div>
              <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                <div id="rail-bar" class="h-full bg-gradient-to-r from-[#00529B] to-[#FF6B35] transition-all duration-500" style="width: 0%"></div>
              </div>
            </div>
          </div>
        </aside>

        <main>
          <!-- Guide -->
          <div id="guide-container">
            <!-- Mobile progress -->
            <div class="lg:hidden mb-6">
              <div class="flex justify-between mb-2">
                <span class="text-sm font-semibold text-[#00529B]" id="step-indicator">Step 1 of 7</span>
                <span class="text-sm text-gray-500" id="progress-percent">0%</span>
              </div>
              <div class="h-2.5 bg-gray-200 rounded-full overflow-hidden">
                <div id="progress-bar" class="h-full bg-gradient-to-r from-[#00529B] to-[#FF6B35] transition-all duration-500" style="width: 0%"></div>
              </div>
            </div>

            <!-- Answer summary -->
            <div id="answer-summary" class="hidden mb-5">
              <div class="flex items-center justify-between mb-2">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Your answers</p>
                <button id="reset-answers" type="button" data-confirm="Clear all your answers?" class="text-xs font-semibold text-gray-400 hover:text-[#C2410C]">Reset</button>
              </div>
              <div id="answer-chips" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Question card -->
            <div class="bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden relative">
              <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#00529B] via-[#FF6B35] to-[#00529B]"></div>
              <div class="p-7 md:p-10">
                <div id="step-container"></div>
                <div class="flex justify-between items-center mt-8 pt-6 border-t-2 border-gray-100">
                  <button id="prev-btn" class="group flex items-center px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl font-semibold transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                    <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Back
                  </button>
                  <button id="next-btn" class="btn-shimmer group flex items-center px-7 py-2.5 bg-gradient-to-r from-[#00529B] to-[#003d73] hover:from-[#003d73] hover:to-[#002a52] text-white rounded-xl font-semibold transition-all disabled:opacity-40 disabled:cursor-not-allowed shadow-lg hover:shadow-xl">
                    Next
                    <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <p class="text-center text-xs text-gray-400 mt-4">Tip: press <kbd class="px-1.5 py-0.5 bg-gray-100 rounded text-gray-500">1</kbd>–<kbd class="px-1.5 py-0.5 bg-gray-100 rounded text-gray-500">4</kbd> to choose an answer</p>
          </div>

          <!-- Results -->
          <div id="results-section" class="hidden">
            <div class="result-enter bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden">
              <div class="relative bg-gradient-to-br from-[#00529B] via-[#003d73] to-[#001f3f] p-8 md:p-10 text-white overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -mr-32 -mt-32"></div>
                <div class="absolute bottom-0 left-0 w-48 h-48 bg-[#C2410C]/20 rounded-full -ml-24 -mb-24"></div>
                <div class="relative z-10">
                  <div class="flex flex-wrap items-center gap-3 mb-3">
                    <span class="px-3 py-1 bg-white/15 border border-white/25 rounded-full text-xs font-bold uppercase tracking-wide">Recommended system</span>
                    <span class="text-blue-200 text-sm" id="result-date"></span>
                  </div>
                  <h2 class="text-3xl md:text-4xl font-bold mb-2" id="result-title">Your Weather Station</h2>
                  <p class="text-blue-100 max-w-2xl" id="result-subtitle">Built from your answers and matched to current Davis products.</p>
                  <div class="flex flex-wrap gap-2 mt-4" id="result-chips"></div>
                </div>
              </div>

              <div class="p-7 md:p-10">
                <!-- Totals -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                  <div class="bg-gray-50 border-2 border-gray-100 rounded-2xl p-5">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">Essentials</p>
                    <p class="text-2xl font-bold text-gray-900" id="total-essential">—</p>
                    <p class="text-xs text-gray-500 mt-1">Core equipment</p>
                  </div>
                  <div class="bg-blue-50 border-2 border-blue-200 rounded-2xl p-5">
                    <p class="text-xs font-bold text-[#00529B] uppercase tracking-wide mb-1">Suggested add-ons</p>
                    <p class="text-2xl font-bold text-[#00529B]" id="total-recommended">—</p>
                    <p class="text-xs text-gray-500 mt-1">Recommended extras</p>
                  </div>
                  <div class="bg-gray-50 border-2 border-gray-100 rounded-2xl p-5">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-1">Total items</p>
                    <p class="text-2xl font-bold text-gray-900" id="total-items">—</p>
                    <p class="text-xs text-gray-500 mt-1">Products in your build</p>
                  </div>
                </div>

                <!-- Items -->
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-2xl font-bold">Your Build</h3>
                  <div class="flex gap-2 text-xs">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-blue-50 text-[#00529B] rounded-full font-semibold"><span class="w-1.5 h-1.5 bg-[#00529B] rounded-full"></span>Essential</span>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-orange-50 text-[#C2410C] rounded-full font-semibold"><span class="w-1.5 h-1.5 bg-[#C2410C] rounded-full"></span>Recommended</span>
                  </div>
                </div>
                <div class="space-y-3 mb-10" id="recommendations"></div>

                <!-- Similar generated setups -->
                <div class="mb-10">
                  <h3 class="text-2xl font-bold mb-1">Similar Setups</h3>
                  <p class="text-gray-500 mb-5 text-sm">Closest matches from <span id="scenario-count">96</span> generated configurations. Pick one to load it into the guide.</p>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="similar-cards"></div>
                </div>

                <!-- Quote -->
                <div class="bg-gradient-to-br from-blue-50 to-white border-2 border-blue-100 rounded-2xl p-7">
                  <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                    <h3 class="text-2xl font-bold text-[#00529B]">Get Your Quote</h3>
                  </div>
                  <p class="text-gray-700 mb-5 text-sm">Choose your country and reseller, add your details, and send the message directly. It already lists your exact build and SKUs.</p>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                      <label for="country-select" class="block text-sm font-semibold text-gray-700 mb-2">Your Country</label>
                      <select id="country-select" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#00529B] focus:border-transparent transition-all bg-white">
                        <option value="">Select your country...</option>
                      </select>
                    </div>
                    <div>
                      <label for="reseller-select" class="block text-sm font-semibold text-gray-700 mb-2">Preferred Reseller</label>
                      <select id="reseller-select" disabled class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#00529B] focus:border-transparent transition-all bg-white disabled:bg-gray-50 disabled:text-gray-400">
                        <option value="">Choose a country first</option>
                      </select>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                      <label for="sender-name" class="block text-sm font-semibold text-gray-700 mb-2">Your Name</label>
                      <input id="sender-name" type="text" maxlength="80" autocomplete="name" placeholder="Juan dela Cruz" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#00529B] focus:border-transparent transition-all bg-white" />
                    </div>
                    <div>
                      <label for="sender-email" class="block text-sm font-semibold text-gray-700 mb-2">Your Email</label>
                      <input id="sender-email" type="email" maxlength="160" autocomplete="email" placeholder="you@example.com" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#00529B] focus:border-transparent transition-all bg-white" />
                    </div>
                  </div>

                  <div class="mb-4">
                    <label for="quote-subject" class="block text-sm font-semibold text-gray-700 mb-2">Subject</label>
                    <input id="quote-subject" type="text" maxlength="150" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#00529B] focus:border-transparent transition-all bg-white" />
                  </div>

                  <div class="mb-4">
                    <label for="email-message" class="block text-sm font-semibold text-gray-700 mb-2">Message</label>
                    <textarea id="email-message" class="w-full p-4 border-2 border-gray-200 rounded-xl font-mono text-xs md:text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#00529B] focus:border-transparent" rows="16"></textarea>
                    <p class="text-xs text-gray-400 mt-1.5">Updates automatically when you pick a country, reseller, name or email. You can edit it before sending.</p>
                  </div>

                  <input id="quote-website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

                  <div id="quote-status" class="hidden mb-4 rounded-xl border-2 px-4 py-3 text-sm font-medium"></div>

                  <p class="text-xs text-gray-500 mb-4">
                    By sending, you agree to our{' '}
                    <a href="/privacy/" class="text-[#00529B] font-semibold hover:underline">Privacy Policy</a>.
                    Your message is delivered to the selected reseller.
                  </p>

                  <div class="flex flex-col sm:flex-row gap-3">
                    <button id="send-quote" class="btn-shimmer flex-1 sm:flex-none px-7 py-3 bg-gradient-to-r from-[#00529B] to-[#003d73] hover:from-[#003d73] hover:to-[#002a52] text-white rounded-xl font-semibold transition-all shadow-lg hover:shadow-xl disabled:opacity-60 disabled:cursor-not-allowed">
                      Send Message
                    </button>
                    <button id="copy-message" class="flex-1 sm:flex-none px-6 py-3 bg-white hover:bg-gray-50 text-gray-700 rounded-xl font-semibold transition-all border-2 border-gray-200 hover:border-gray-300">
                      Copy
                    </button>
                    <a href="/resellers/" class="flex-1 sm:flex-none px-6 py-3 bg-white hover:bg-gray-50 text-gray-700 rounded-xl font-semibold transition-all border-2 border-gray-200 hover:border-gray-300 text-center">
                      Find Resellers
                    </a>
                    <button id="print-results" class="flex-1 sm:flex-none px-6 py-3 bg-white hover:bg-gray-50 text-gray-700 rounded-xl font-semibold transition-all border-2 border-gray-200 hover:border-gray-300">
                      Print
                    </button>
                    <button id="restart-guide" type="button" data-confirm="Start over? Your current recommendations will be cleared." class="flex-1 sm:flex-none px-6 py-3 bg-white hover:bg-gray-50 text-gray-700 rounded-xl font-semibold transition-all border-2 border-gray-200 hover:border-gray-300">
                      Start Over
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <p class="text-center text-xs text-gray-400 mt-5">Product availability and pricing vary by reseller and country. Request a local quote for exact details.</p>
          </div>
        </main>
      </div>
    </div>
  </section>

  <script define:vars={{ productIndex, resellerIndex }}>
    const steps = [
      {
        key: 'use',
        title: 'What will you monitor?',
        subtitle: 'This sets the station class and sensor priorities.',
        icon: '🎯',
        options: [
          { id: 'home', label: 'Home & Backyard', desc: 'Personal weather', emoji: '🏡' },
          { id: 'agriculture', label: 'Agriculture & Farming', desc: 'Crops, soil, irrigation', emoji: '🚜' },
          { id: 'research', label: 'Research & Professional', desc: 'Scientific-grade data', emoji: '🔬' },
          { id: 'education', label: 'Education & STEM', desc: 'Schools and projects', emoji: '🎓' },
        ],
      },
      {
        key: 'coverage',
        title: 'How large is the area?',
        subtitle: 'Coverage decides whether a single station or a network fits.',
        icon: '🗺️',
        options: [
          { id: 'single_site', label: 'One Location', desc: 'A yard, roof or single field', emoji: '📍' },
          { id: 'multi_field', label: 'Multiple Fields', desc: 'Several blocks or plots', emoji: '🌾' },
          { id: 'large_area', label: 'Large Property', desc: 'Remote or sprawling site', emoji: '🏞️' },
        ],
      },
      {
        key: 'site',
        title: 'Where will it be installed?',
        subtitle: 'We use this to pick the right mounting hardware.',
        icon: '🏗️',
        options: [
          { id: 'open_field', label: 'Open Field', desc: 'Unobstructed sky view', emoji: '🌾' },
          { id: 'rooftop', label: 'Rooftop', desc: 'On a roof structure', emoji: '🏢' },
          { id: 'pole', label: 'Pole Mount', desc: 'Free-standing pole', emoji: '📡' },
          { id: 'building', label: 'Wall or Eave', desc: 'Attached mounting', emoji: '🏠' },
        ],
      },
      {
        key: 'power',
        title: 'Is mains power available?',
        subtitle: 'No outlet? We will switch to solar-powered options.',
        icon: '⚡',
        options: [
          { id: 'yes_power', label: 'Yes, AC Power', desc: 'Outlet within reach', emoji: '🔌' },
          { id: 'no_power', label: 'No Power', desc: 'Off-grid or remote', emoji: '🔋' },
          { id: 'unsure', label: 'Not Sure', desc: 'We will plan for solar', emoji: '❓' },
        ],
      },
      {
        key: 'connectivity',
        title: 'How will you access data?',
        subtitle: 'Cloud, cellular, or local display only.',
        icon: '🌐',
        options: [
          { id: 'yes_wifi', label: 'Wi-Fi / Internet', desc: 'WeatherLink.com and app', emoji: '📶' },
          { id: 'yes_cellular', label: 'Cellular', desc: 'No internet at the site', emoji: '📱' },
          { id: 'no_upload', label: 'Local Only', desc: 'Console display only', emoji: '💾' },
        ],
      },
      {
        key: 'sensors',
        title: 'Which extra sensors?',
        subtitle: 'Choose the closest match — you can add more later.',
        icon: '🌡️',
        options: [
          { id: 'basic', label: 'Weather Only', desc: 'Temp, humidity, rain, wind', emoji: '🌦️' },
          { id: 'agriculture', label: 'Soil & Leaf', desc: 'Moisture and wetness', emoji: '🌱' },
          { id: 'uv_solar', label: 'UV & Solar', desc: 'Radiation and ET', emoji: '☀️' },
          { id: 'complete', label: 'Everything', desc: 'All available sensors', emoji: '🎛️' },
        ],
      },
      {
        key: 'range',
        title: 'How far are the sensors?',
        subtitle: 'Line of sight from sensor suite to receiver.',
        icon: '📶',
        options: [
          { id: 'close', label: 'Under 300 ft', desc: 'Standard range', emoji: '📍' },
          { id: 'medium', label: '300–800 ft', desc: 'Usually fine', emoji: '📏' },
          { id: 'far', label: 'Over 800 ft', desc: 'Add a repeater', emoji: '📡' },
        ],
      },
    ];

    let currentStep = 0;
    const answers = {};

    const stepContainer = document.getElementById('step-container');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const progressBar = document.getElementById('progress-bar');
    const stepIndicator = document.getElementById('step-indicator');
    const progressPercent = document.getElementById('progress-percent');
    const rail = document.getElementById('step-rail');
    const railBar = document.getElementById('rail-bar');
    const railPercent = document.getElementById('rail-percent');
    const answerSummary = document.getElementById('answer-summary');
    const answerChips = document.getElementById('answer-chips');
    const resetAnswers = document.getElementById('reset-answers');
    const guideContainer = document.getElementById('guide-container');
    const resultsSection = document.getElementById('results-section');
    const recommendationsDiv = document.getElementById('recommendations');
    const totalEssential = document.getElementById('total-essential');
    const totalRecommended = document.getElementById('total-recommended');
    const totalItems = document.getElementById('total-items');
    const resultTitle = document.getElementById('result-title');
    const resultSubtitle = document.getElementById('result-subtitle');
    const resultChips = document.getElementById('result-chips');
    const resultDate = document.getElementById('result-date');
    const similarCards = document.getElementById('similar-cards');
    const countrySelect = document.getElementById('country-select');
    const resellerSelect = document.getElementById('reseller-select');
    const senderName = document.getElementById('sender-name');
    const senderEmail = document.getElementById('sender-email');
    const subjectInput = document.getElementById('quote-subject');
    const emailMessage = document.getElementById('email-message');
    const honeypot = document.getElementById('quote-website');
    const quoteStatus = document.getElementById('quote-status');
    const sendBtn = document.getElementById('send-quote');
    const copyBtn = document.getElementById('copy-message');
    const restartBtn = document.getElementById('restart-guide');
    const printBtn = document.getElementById('print-results');
    const quickStart = document.getElementById('quick-start');

    const countries = [...new Set(resellerIndex.map((r) => r.country))].sort((a, b) => a.localeCompare(b));
    countries.forEach((c) => {
      const opt = document.createElement('option');
      opt.value = c;
      opt.textContent = c;
      countrySelect.appendChild(opt);
    });

    function selectedReseller() {
      return resellerIndex.find((r) => r.slug === resellerSelect.value) || null;
    }

    function populateResellers() {
      const country = countrySelect.value;
      const list = resellerIndex
        .filter((r) => r.country === country)
        .sort((a, b) => a.name.localeCompare(b.name));

      resellerSelect.innerHTML = '<option value="">' + (country ? (list.length ? 'Select a reseller...' : 'No email contact listed') : 'Choose a country first') + '</option>';
      list.forEach((r) => {
        const opt = document.createElement('option');
        opt.value = r.slug;
        opt.textContent = r.name + (r.city ? ' — ' + r.city : '');
        resellerSelect.appendChild(opt);
      });

      resellerSelect.disabled = list.length === 0;
      if (list.length === 1) resellerSelect.value = list[0].slug;
      updateMessage();
    }

    const product = (slug) => productIndex.find((p) => p.slug === slug);
    const labelFor = (key, value) => {
      const step = steps.find((s) => s.key === key);
      return step && step.options.find((o) => o.id === value) ? step.options.find((o) => o.id === value).label : '';
    };

    function renderRail() {
      rail.innerHTML = steps.map((s, i) => {
        const done = Boolean(answers[s.key]);
        const active = i === currentStep;
        return `
          <li>
            <button class="rail-step w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left transition-all ${active ? 'bg-blue-50 text-[#00529B]' : done ? 'text-gray-700 hover:bg-gray-50' : 'text-gray-400'}" data-step="${i}">
              <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 ${done ? 'bg-[#00529B] text-white' : active ? 'bg-[#00529B] text-white' : 'bg-gray-100 text-gray-400'}">
                ${done && !active ? '<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>' : i + 1}
              </span>
              <span class="text-sm font-medium leading-tight">${s.title.replace('?', '')}</span>
            </button>
          </li>
        `;
      }).join('');

      rail.querySelectorAll('.rail-step').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.step);
          if (idx <= maxReachable()) { currentStep = idx; renderStep(); }
        });
      });

      const answered = Object.keys(answers).length;
      const pct = Math.round((answered / steps.length) * 100);
      railBar.style.width = pct + '%';
      railPercent.textContent = pct + '%';
    }

    function maxReachable() {
      let last = 0;
      for (let i = 0; i < steps.length; i++) {
        if (answers[steps[i].key]) last = i + 1;
        else break;
      }
      return Math.min(last, steps.length - 1);
    }

    function renderSummary() {
      const entries = steps.filter((s) => answers[s.key]).map((s) => ({ key: s.key, label: labelFor(s.key, answers[s.key]), index: steps.indexOf(s) }));
      answerSummary.classList.toggle('hidden', entries.length === 0);
      answerChips.innerHTML = entries.map((e) => `
        <button class="answer-chip inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-gray-200 rounded-full text-xs font-medium text-gray-700 hover:border-[#00529B] hover:text-[#00529B] transition-all shadow-sm" data-step="${e.index}">
          ${e.label}
          <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
        </button>
      `).join('');
      answerChips.querySelectorAll('.answer-chip').forEach((chip) => {
        chip.addEventListener('click', () => { currentStep = Number(chip.dataset.step); renderStep(); });
      });
    }

    function renderStep() {
      const step = steps[currentStep];
      const progress = (currentStep / steps.length) * 100;
      progressBar.style.width = progress + '%';
      stepIndicator.textContent = `Step ${currentStep + 1} of ${steps.length}`;
      progressPercent.textContent = Math.round(progress) + '%';

      stepContainer.innerHTML = `
        <div class="guide-step-enter">
          <div class="flex items-start gap-4 mb-7">
            <div class="text-5xl">${step.icon}</div>
            <div>
              <p class="text-xs font-bold text-[#C2410C] uppercase tracking-wider mb-1">Step ${currentStep + 1}</p>
              <h2 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight">${step.title}</h2>
              <p class="text-gray-600 mt-1">${step.subtitle}</p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            ${step.options.map((opt) => {
              const selected = answers[step.key] === opt.id;
              return `
                <button class="option-btn group relative text-left p-5 border-2 rounded-2xl transition-all ${selected ? 'border-[#00529B] bg-gradient-to-br from-blue-50 to-white shadow-lg' : 'border-gray-200 hover:border-[#00529B]/60 hover:shadow-md bg-white'}" data-option="${opt.id}">
                  <div class="flex items-center gap-3">
                    <span class="text-3xl">${opt.emoji}</span>
                    <div class="flex-1 min-w-0">
                      <div class="font-bold text-gray-900 group-hover:text-[#00529B] transition-colors text-sm md:text-base">${opt.label}</div>
                      <div class="text-xs md:text-sm text-gray-500">${opt.desc}</div>
                    </div>
                    <span class="w-6 h-6 rounded-full border-2 flex items-center justify-center flex-shrink-0 ${selected ? 'border-[#00529B] bg-[#00529B]' : 'border-gray-300 group-hover:border-[#00529B]'}">
                      ${selected ? '<svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>' : ''}
                    </span>
                  </div>
                </button>
              `;
            }).join('')}
          </div>
        </div>
      `;

      stepContainer.querySelectorAll('.option-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          answers[step.key] = btn.dataset.option;
          renderSummary();
          renderRail();
          if (currentStep === steps.length - 1) {
            setTimeout(showResults, 180);
          } else {
            setTimeout(() => { currentStep++; renderStep(); }, 180);
          }
        });
      });

      prevBtn.disabled = currentStep === 0;
      nextBtn.disabled = !answers[step.key];
      nextBtn.innerHTML = currentStep === steps.length - 1
        ? 'See My Build <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>'
        : 'Next <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>';

      renderRail();
      renderSummary();
    }

    prevBtn.addEventListener('click', () => {
      if (currentStep > 0) { currentStep--; renderStep(); }
    });
    nextBtn.addEventListener('click', () => {
      if (currentStep < steps.length - 1) { currentStep++; renderStep(); }
      else showResults();
    });

    document.addEventListener('keydown', (e) => {
      if (resultsSection.classList.contains('hidden') === false) return;
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;
      const n = Number(e.key);
      if (n >= 1 && n <= steps[currentStep].options.length) {
        const btn = stepContainer.querySelectorAll('.option-btn')[n - 1];
        if (btn) btn.click();
      }
      if (e.key === 'ArrowLeft') prevBtn.click();
    });

    resetAnswers.addEventListener('click', () => {
      Object.keys(answers).forEach((k) => delete answers[k]);
      currentStep = 0;
      renderStep();
    });

    // ---------------- Recommendation logic ----------------
    function buildRecs(input = answers) {
      const items = [];
      const add = (slug, tier, reason) => {
        if (!slug || !product(slug) || items.some((i) => i.slug === slug)) return;
        items.push({ slug, tier, reason });
      };

      const offGrid = input.power === 'no_power';
      const enterprise = input.coverage !== 'single_site' || offGrid;
      const wantsSoil = input.sensors === 'agriculture' || input.sensors === 'complete' || input.use === 'agriculture';
      const wantsRadiation = input.sensors === 'uv_solar' || input.sensors === 'complete' || input.use === 'research';

      if (enterprise) {
        add('enviromonitor', 'essential', 'Solar-powered monitoring platform for remote or multi-site coverage');
        add('enviromonitor-node', 'essential', 'Connects your sensors in the field over long-range wireless');
        if (input.connectivity === 'yes_cellular' || offGrid) {
          add('enviromonitor', 'essential', 'LTE gateway uploads data without Wi-Fi or mains power');
        } else {
          add('enviromonitor-ip-gateway-wi-fi-ethernet', 'essential', 'Wi-Fi/Ethernet gateway for WeatherLink cloud upload');
        }
        if (input.coverage === 'large_area') {
          add('enviromonitor-long-range-antenna-8dbi', 'recommended', 'Boosts gateway range across a large property');
        }
      } else {
        if (input.use === 'home') {
          if (input.sensors === 'basic') {
            add('vantage-vue', 'essential', 'All-in-one station — simplest install and best value for a home');
          } else {
            add('vantage-pro2', 'essential', 'Expandable professional station ready for the sensors you chose');
          }
        } else if (input.use === 'education') {
          add('vantage-vue', 'essential', 'Easy-to-install station with everything a classroom needs');
        } else if (input.use === 'agriculture') {
          add('vantage-pro2-plus', 'essential', 'Pro station with ET and radiation data for crop decisions');
        } else {
          add('vantage-pro2-plus', 'essential', 'Research-grade station with UV and solar radiation');
        }

        if (input.connectivity === 'yes_wifi') {
          add('weatherlink-live', 'essential', 'Wi-Fi/Ethernet upload to WeatherLink.com and the mobile app');
          add('weatherlink-console', 'recommended', 'Optional local touchscreen display for the same data');
        } else if (input.connectivity === 'no_upload') {
          add('weatherlink-console', 'essential', 'Local color display and data storage — no cloud required');
        } else if (enterprise) {
          add('enviromonitor', 'essential', 'LTE gateway for sites without Wi-Fi — pairs with EnviroMonitor nodes');
          add('enviromonitor-node', 'essential', 'Connects your sensors to the LTE gateway');
        } else {
          add('weatherlink-live', 'essential', 'Cloud upload through a cellular router at the site (router not included)');
          add('weatherlink-console', 'recommended', 'Optional local touchscreen display for the same data');
        }

        if (input.range === 'far') {
          add('wireless-long-range-repeater-with-solar-power', 'essential', 'Extends wireless range beyond the standard 1,000 ft');
        }
      }

      if (wantsSoil) {
        add('soil-moisture-station', 'recommended', 'Soil moisture and temperature at multiple depths');
        add('leaf-wetness-sensor', 'recommended', 'Leaf wetness duration for disease forecasting');
      }
      if (wantsRadiation) {
        add('uv-sensor', 'recommended', 'UV index, dose rate and daily accumulated dose');
        add('solar-radiation-sensor', 'recommended', 'Solar radiation for evapotranspiration and THSW index');
        add('sensor-mounting-shelf-2', 'recommended', 'Mounts the UV and solar sensors on the station');
      }

      if (input.site === 'open_field' || input.site === 'rooftop') {
        add('mounting-tripod-lag-bolts', 'recommended', 'Stable tripod for open ground or a roof platform');
      } else if (input.site === 'pole' || input.site === 'building') {
        add('mounting-pole-kit', 'recommended', 'Pole or bracket mounting for a clean, level install');
      }

      return items;
    }

    function systemName(input = answers) {
      if (input.coverage !== 'single_site' || input.power === 'no_power') return 'EnviroMonitor System';
      if (input.use === 'home' && input.sensors === 'basic') return 'Vantage Vue System';
      if (input.use === 'education') return 'Vantage Vue System';
      if (input.use === 'agriculture' || input.use === 'research') return 'Vantage Pro2 Plus System';
      return 'Vantage Pro2 System';
    }

    const similarityWeights = { use: 6, coverage: 3, sensors: 2, connectivity: 2, power: 2, site: 1, range: 1 };

    function scenarioKey(a) {
      return ['use', 'coverage', 'sensors', 'connectivity', 'site', 'power', 'range']
        .map((key) => a[key])
        .join('|');
    }

    const scenarioCatalog = (() => {
      const uses = ['home', 'agriculture', 'research', 'education'];
      const coverages = ['single_site', 'multi_field', 'large_area'];
      const sensorSets = ['basic', 'agriculture', 'uv_solar', 'complete'];
      const connectivities = ['yes_wifi', 'yes_cellular'];
      const scenarios = [];

      for (const use of uses) {
        for (const coverage of coverages) {
          for (const sensors of sensorSets) {
            for (const connectivity of connectivities) {
              const single = coverage === 'single_site';
              const site = single
                ? (use === 'home' || use === 'education'
                    ? (sensors === 'basic' ? 'open_field' : 'rooftop')
                    : 'open_field')
                : (coverage === 'large_area' ? 'pole' : 'open_field');
              const power = single ? 'yes_power' : 'no_power';
              const range = single ? (use === 'research' ? 'medium' : 'close') : 'far';
              const scenarioAnswers = { use, coverage, site, power, connectivity, sensors, range };
              scenarios.push({ key: scenarioKey(scenarioAnswers), answers: scenarioAnswers });
            }
          }
        }
      }

      return scenarios;
    })();

    document.getElementById('scenario-count').textContent = String(scenarioCatalog.length);

    function scenarioDistance(a) {
      let distance = 0;
      for (const [key, weight] of Object.entries(similarityWeights)) {
        if (a[key] !== answers[key]) distance += weight;
      }
      return distance;
    }

    function similarSetups(limit = 4) {
      const currentKey = scenarioKey(answers);
      const alternatives = scenarioCatalog.filter((scenario) =>
        scenario.key !== currentKey &&
        (scenario.answers.use !== answers.use ||
          scenario.answers.coverage !== answers.coverage ||
          scenario.answers.sensors !== answers.sensors ||
          scenario.answers.connectivity !== answers.connectivity)
      );
      const pool = alternatives.length
        ? alternatives
        : scenarioCatalog.filter((scenario) => scenario.key !== currentKey);

      return pool
        .map((scenario) => ({
          ...scenario,
          distance: scenarioDistance(scenario.answers),
          recs: buildRecs(scenario.answers),
        }))
        .sort((a, b) => a.distance - b.distance || a.answers.use.localeCompare(b.answers.use))
        .slice(0, limit);
    }

    function scenarioTitle(a) {
      const useNames = { home: 'Home', agriculture: 'Agriculture', research: 'Research', education: 'Education' };
      return `${useNames[a.use] || ''} ${systemName(a).replace(' System', '')}`.trim();
    }

    function scenarioDifference(a) {
      const differences = [];
      if (a.use !== answers.use) differences.push(labelFor('use', a.use));
      if (a.sensors !== answers.sensors) differences.push(`Sensors: ${labelFor('sensors', a.sensors)}`);
      if (a.connectivity !== answers.connectivity) differences.push(labelFor('connectivity', a.connectivity));
      if (a.range !== answers.range) differences.push(a.range === 'far' ? 'Long-range repeater' : labelFor('range', a.range));
      return differences.slice(0, 2).join(' · ') || 'Different mounting or power';
    }

    function applyScenario(scenario) {
      Object.keys(answers).forEach((key) => delete answers[key]);
      Object.assign(answers, scenario.answers);
      currentStep = steps.length - 1;
      subjectInput.value = '';
      renderStep();
      showResults();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function showResults() {
      guideContainer.style.display = 'none';
      resultsSection.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      const recs = buildRecs();
      const essentials = recs.filter((r) => r.tier === 'essential');

      resultTitle.textContent = systemName();
      resultSubtitle.textContent = `${essentials.length} essentials + ${recs.length - essentials.length} suggested add-ons, matched to your answers.`;
      resultDate.textContent = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
      resultChips.innerHTML = steps.filter((s) => answers[s.key]).map((s) => `<span class="px-2.5 py-1 bg-white/10 border border-white/20 rounded-full text-xs">${labelFor(s.key, answers[s.key])}</span>`).join('');

      totalEssential.textContent = String(essentials.length);
      totalRecommended.textContent = String(recs.length - essentials.length);
      totalItems.textContent = String(recs.length);

      recommendationsDiv.innerHTML = recs.map((rec) => {
        const p = product(rec.slug);
        if (!p) return '';
        const badge = rec.tier === 'essential'
          ? '<span class="px-2 py-0.5 bg-blue-50 text-[#00529B] text-[10px] font-bold uppercase tracking-wide rounded-full">Essential</span>'
          : '<span class="px-2 py-0.5 bg-orange-50 text-[#C2410C] text-[10px] font-bold uppercase tracking-wide rounded-full">Recommended</span>';
        return `
          <a href="/products/${p.slug}/" class="group flex items-start gap-4 p-4 bg-white border-2 border-gray-100 hover:border-[#00529B]/40 rounded-2xl transition-all hover:shadow-md">
            <div class="w-16 h-16 bg-gray-50 rounded-xl border border-gray-100 flex items-center justify-center flex-shrink-0 overflow-hidden">
              ${p.image ? `<img src="${p.image}" srcset="${p.image.replace('.webp', '-400.webp')} 400w, ${p.image} 900w" sizes="80px" alt="${p.name}" class="w-full h-full object-contain p-1.5" loading="lazy" decoding="async" />` : '<span class="text-xl">📦</span>'}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                ${badge}
                <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-wide">${p.category}</span>
                ${p.sku ? `<span class="text-[10px] text-gray-400">SKU ${p.sku}</span>` : ''}
              </div>
              <div class="font-bold text-sm text-gray-900 group-hover:text-[#00529B] transition-colors leading-snug">${p.name}</div>
              <p class="text-xs text-gray-500 mt-0.5">${rec.reason}</p>
            </div>
            <svg class="w-4 h-4 text-gray-300 group-hover:text-[#00529B] group-hover:translate-x-0.5 transition-all flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        `;
      }).join('');

      const similar = similarSetups();
      similarCards.innerHTML = similar.map((scenario, index) => {
        const items = scenario.recs.map((rec) => product(rec.slug)).filter(Boolean);
        return `
          <button type="button" data-similar="${index}" class="text-left bg-white border-2 border-gray-100 rounded-2xl p-5 hover:shadow-lg hover:border-[#00529B]/30 transition-all">
            <div class="flex items-center justify-between gap-3 mb-2">
              <span class="px-2 py-0.5 bg-blue-50 text-[#00529B] text-[10px] font-bold uppercase tracking-wide rounded-full">Similar setup</span>
              <span class="text-xs text-gray-500">${items.length} products</span>
            </div>
            <h4 class="font-bold text-gray-900">${scenarioTitle(scenario.answers)}</h4>
            <p class="text-xs text-gray-500 mt-1">${[
              labelFor('coverage', scenario.answers.coverage),
              labelFor('site', scenario.answers.site),
              labelFor('power', scenario.answers.power),
            ].join(' · ')}</p>
            <p class="text-xs font-semibold text-[#C2410C] mt-2">${scenarioDifference(scenario.answers)}</p>
            <div class="flex -space-x-3 my-4">
              ${items.slice(0, 3).map((item) => `
                <div class="w-11 h-11 rounded-full bg-gray-50 border-2 border-white flex items-center justify-center overflow-hidden shadow-sm">
                  ${item.image ? `<img src="${item.image}" srcset="${item.image.replace('.webp', '-400.webp')} 400w, ${item.image} 900w" sizes="48px" alt="${item.name}" class="w-full h-full object-contain p-1" loading="lazy" decoding="async" />` : '<span class="text-base">📦</span>'}
                </div>
              `).join('')}
            </div>
            <ul class="text-xs text-gray-600 space-y-1 mb-4">
              ${items.slice(0, 3).map((item) => `<li class="truncate">• ${item.name}</li>`).join('')}
              ${items.length > 3 ? `<li class="text-gray-400">+ ${items.length - 3} more</li>` : ''}
            </ul>
            <span class="inline-flex items-center text-xs font-semibold text-[#00529B]">Load this setup →</span>
          </button>
        `;
      }).join('');

      similarCards.querySelectorAll('[data-similar]').forEach((button) => {
        button.addEventListener('click', () => {
          const scenario = similar[Number(button.dataset.similar)];
          if (scenario) applyScenario(scenario);
        });
      });

      updateMessage();
      populateResellers();
    }

    function updateMessage() {
      const country = countrySelect.value || '[Your Country/Region]';
      const reseller = selectedReseller();
      const recs = buildRecs();
      const lines = recs.map((rec) => {
        const p = product(rec.slug);
        if (!p) return '';
        return `• ${p.name}${p.sku ? ` (SKU ${p.sku})` : ''} [${rec.tier === 'essential' ? 'Essential' : 'Recommended'}]`;
      }).filter(Boolean);

      const customerName = senderName.value.trim() || '[Your Name]';
      const customerEmail = senderEmail.value.trim() || '[Your Email]';

      emailMessage.value = `Dear ${reseller ? reseller.name : 'Authorized Davis Instruments Reseller'} Team,

I used the Davis Weather Station Smart Buying Guide and would like a quotation for this configuration:

RECOMMENDED COMPONENTS:
${lines.join('\n')}

MY REQUIREMENTS:
• Primary Use: ${labelFor('use', answers.use)}
• Coverage: ${labelFor('coverage', answers.coverage)}
• Installation: ${labelFor('site', answers.site)}
• Power: ${labelFor('power', answers.power)}
• Connectivity: ${labelFor('connectivity', answers.connectivity)}
• Sensors: ${labelFor('sensors', answers.sensors)}
• Wireless Range: ${labelFor('range', answers.range)}
• Location/Country: ${country}

Please provide:
- Itemized pricing including shipping
- Availability and lead times
- Installation, commissioning and training options
- Warranty information

Thank you.

Best regards,
${customerName}
${customerEmail}`;

      if (!subjectInput.value.trim()) {
        subjectInput.value = `Quote Request — ${systemName()}`;
      }
    }

    countrySelect.addEventListener('change', populateResellers);
    resellerSelect.addEventListener('change', updateMessage);
    senderName.addEventListener('input', updateMessage);
    senderEmail.addEventListener('input', updateMessage);

    function showStatus(message, type) {
      quoteStatus.textContent = message;
      quoteStatus.className = 'mb-4 rounded-xl border-2 px-4 py-3 text-sm font-medium ' + (type === 'success'
        ? 'bg-green-50 border-green-200 text-green-800'
        : 'bg-red-50 border-red-200 text-red-700');
    }

    function clearStatus() {
      quoteStatus.className = 'hidden mb-4 rounded-xl border-2 px-4 py-3 text-sm font-medium';
      quoteStatus.textContent = '';
    }

    sendBtn.addEventListener('click', async () => {
      clearStatus();
      const reseller = selectedReseller();
      if (!reseller) return showStatus('Please choose a reseller.', 'error');
      if (senderName.value.trim().length < 2) return showStatus('Please enter your name.', 'error');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(senderEmail.value.trim())) return showStatus('Please enter a valid email address.', 'error');
      if (subjectInput.value.trim().length < 3) return showStatus('Please enter a subject.', 'error');
      if (emailMessage.value.trim().length < 20) return showStatus('Please enter a message.', 'error');
      if (honeypot.value) return;

      const configuration = {
        systemName: systemName(),
        items: buildRecs()
          .map((rec) => {
            const item = product(rec.slug);
            if (!item) return null;
            return { name: item.name, sku: item.sku, category: item.category, tier: rec.tier, slug: item.slug };
          })
          .filter(Boolean),
        answers: steps
          .filter((step) => answers[step.key])
          .map((step) => ({ label: step.title.replace('?', ''), value: labelFor(step.key, answers[step.key]) })),
      };

      sendBtn.disabled = true;
      sendBtn.textContent = 'Sending…';

      try {
        const response = await fetch('/api/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: senderName.value.trim(),
            email: senderEmail.value.trim(),
            subject: subjectInput.value.trim(),
            message: emailMessage.value.trim(),
            country: countrySelect.value,
            resellerSlug: reseller.slug,
            configuration,
            website: honeypot.value,
          }),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Could not send your message.');
        if (data.routed) {
          showStatus(`Request received. Our team will forward it to ${reseller.name}, and they will reply to ${senderEmail.value.trim()}.`, 'success');
        } else {
          showStatus(`Message sent to ${reseller.name}. They will reply to ${senderEmail.value.trim()}.`, 'success');
        }
        sendBtn.textContent = 'Message Sent';
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'Could not send your message.', 'error');
        sendBtn.disabled = false;
        sendBtn.textContent = 'Send Message';
      }
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailMessage.value);
      } catch {
        emailMessage.select();
        document.execCommand('copy');
      }
      copyBtn.textContent = '✓ Copied!';
      setTimeout(() => (copyBtn.textContent = 'Copy Message'), 2200);
    });

    printBtn.addEventListener('click', () => window.print());

    restartBtn.addEventListener('click', () => {
      currentStep = 0;
      Object.keys(answers).forEach((k) => delete answers[k]);
      guideContainer.style.display = 'block';
      resultsSection.classList.add('hidden');
      countrySelect.value = '';
      resellerSelect.innerHTML = '<option value="">Choose a country first</option>';
      resellerSelect.disabled = true;
      subjectInput.value = '';
      emailMessage.value = '';
      clearStatus();
      sendBtn.disabled = false;
      sendBtn.textContent = 'Send Message';
      renderStep();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    quickStart.addEventListener('click', () => {
      Object.assign(answers, {
        use: 'home',
        coverage: 'single_site',
        site: 'open_field',
        power: 'yes_power',
        connectivity: 'yes_wifi',
        sensors: 'basic',
        range: 'close',
      });
      currentStep = steps.length - 1;
      renderStep();
      showResults();
    });

    renderStep();
  </script>
</Layout>
