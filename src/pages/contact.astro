---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us" description="Contact Davis Weather Station for reseller corrections, privacy requests, and product questions.">
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Contact Us</h1>
        <p class="text-xl text-gray-600">Have questions or need assistance? We're here to help.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
        <div class="bg-white border border-gray-200 rounded-xl p-8">
          <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-[#00529B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold mb-2">Email</h2>
          <p class="text-gray-600 mb-4">Send us an email and we'll get back to you</p>
          <a href="mailto:hello@davisweatherstation.com" class="text-[#00529B] hover:underline font-semibold">
            hello@davisweatherstation.com
          </a>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl p-8">
          <div class="w-12 h-12 bg-orange-50 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-[#C2410C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold mb-2">Report Abuse</h2>
          <p class="text-gray-600 mb-4">Report inappropriate content or issues</p>
          <a href="mailto:contact@davisweatherstation.com" class="text-[#C2410C] hover:underline font-semibold">
            contact@davisweatherstation.com
          </a>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl p-8 md:p-10">
        <h2 class="text-2xl font-bold mb-4">General Inquiries</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          For questions about resellers, product information, or general inquiries about Davis Instruments weather stations, please email us at <a href="mailto:hello@davisweatherstation.com" class="text-[#00529B] hover:underline">hello@davisweatherstation.com</a>.
        </p>
        <p class="text-gray-700 leading-relaxed">
          For product purchases, technical support, or warranty issues, please contact the authorized reseller in your region directly. They are best equipped to assist you with sales, installation, and support.
        </p>
      </div>
    </div>
  </section>
</Layout>
