---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { env } from 'cloudflare:workers';
import { asset } from '../../data/assets';
import { blogCategorySlug, blogDateISO, formatBlogDate } from '../../utils/blog';

const cfEnv = env as unknown as { DB: D1Database };
const { slug = '' } = Astro.params;
const site = 'https://davisweatherstation.com';

interface BlogPost {
  slug: string;
  title: string;
  excerpt: string;
  content: string;
  category: string;
  tags: string | null;
  era: string | null;
  featured_image: string | null;
  image_alt: string | null;
  image_credit: string | null;
  image_credit_url: string | null;
  author: string;
  published_at: string;
  updated_at: string;
  reading_time: number;
}

let post: BlogPost | null = null;
let related: BlogPost[] = [];
let views = 0;

try {
  const db = cfEnv.DB;
  post = await db
    .prepare(
      `SELECT slug, title, excerpt, content, category, tags, era, featured_image, image_alt,
              image_credit, image_credit_url, author, published_at, updated_at, reading_time
       FROM blog_posts
       WHERE slug = ? AND status IN ('scheduled', 'published') AND published_at <= datetime('now')
       LIMIT 1`
    )
    .bind(slug)
    .first<BlogPost>();

  if (post) {
    const rows = await db
      .prepare(
        `SELECT slug, title, excerpt, category, featured_image, image_alt, published_at, reading_time, era
         FROM blog_posts
         WHERE category = ? AND slug != ? AND status IN ('scheduled', 'published')
           AND published_at <= datetime('now')
         ORDER BY published_at DESC LIMIT 3`
      )
      .bind(post.category, post.slug)
      .all<BlogPost>();
    related = rows.results || [];

    const viewRow = await db
      .prepare('SELECT views FROM page_views WHERE path = ?')
      .bind(`/blog/${post.slug}/`)
      .first<{ views: number }>()
      .catch(() => null);
    views = Number(viewRow?.views || 0);
  }
} catch {
  post = null;
}

if (!post) {
  Astro.response.status = 404;
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');

const pageUrl = `${site}/blog/${slug}/`;
const featuredImage = post?.featured_image
  ? post.featured_image.startsWith('http')
    ? post.featured_image
    : new URL(asset(post.featured_image), site).toString()
  : `${site}/images/og-image.png`;
const tags = post?.tags ? (JSON.parse(post.tags) as string[]) : [];
const categoryUrl = post ? `/blog/category/${blogCategorySlug(post.category)}/` : '/blog/';

const schema = post
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BlogPosting',
          headline: post.title,
          description: post.excerpt,
          image: [featuredImage],
          datePublished: blogDateISO(post.published_at),
          dateModified: blogDateISO(post.updated_at),
          author: { '@type': 'Person', name: post.author },
          publisher: { '@id': `${site}/#organization` },
          mainEntityOfPage: pageUrl,
          articleSection: post.category,
          keywords: tags.join(', '),
          wordCount: post.content.replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length,
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
            { '@type': 'ListItem', position: 2, name: 'Weather Notes', item: `${site}/blog/` },
            { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
          ],
        },
      ],
    }
  : null;
---

{post ? (
  <Layout title={post.title} description={post.excerpt}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <article class="py-10 md:py-14">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="mb-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-500">
          <a href="/" class="hover:text-[#00529B]">Home</a>
          <span>/</span>
          <a href="/blog/" class="hover:text-[#00529B]">Weather Notes</a>
          <span>/</span>
          <a href={categoryUrl} class="hover:text-[#00529B]">{post.category}</a>
        </nav>

        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-2 text-xs mb-4">
            <a href={categoryUrl} class="px-2.5 py-1 bg-blue-50 text-[#00529B] rounded-full font-semibold hover:bg-blue-100 transition-colors">{post.category}</a>
          </div>
          <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4">{post.title}</h1>
          <p class="text-xl text-gray-600 leading-relaxed mb-5">{post.excerpt}</p>
          <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
            <span>By {post.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={post.published_at}>{formatBlogDate(post.published_at)}</time>
            <span aria-hidden="true">·</span>
            <span>{post.reading_time} min read</span>
            <span aria-hidden="true">·</span>
            <span><span data-page-views>{views.toLocaleString('en-US')}</span> <span data-page-views-suffix>{views === 1 ? 'view' : 'views'}</span></span>
          </div>
        </header>

        {featuredImage && (
          <figure class="mb-8">
            <img
              src={featuredImage}
              alt={post.image_alt || post.title}
              width="1200"
              height="800"
              class="w-full h-auto rounded-2xl border border-gray-200 object-cover"
              fetchpriority="high"
              decoding="async"
            />
            {post.image_credit && (
              <figcaption class="mt-2 text-xs text-gray-400">
                {post.image_credit}
                {post.image_credit_url && (
                  <>
                    {' · '}
                    <a href={post.image_credit_url} target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-600">Source</a>
                  </>
                )}
              </figcaption>
            )}
          </figure>
        )}

        <div class="legal-content blog-content text-gray-700 leading-relaxed" set:html={post.content} />

        <div class="mt-10 bg-gradient-to-br from-blue-50 to-white border-2 border-blue-100 rounded-2xl p-6 md:p-8">
          <h2 class="text-2xl font-bold text-[#00529B] mb-2">Planning a weather station?</h2>
          <p class="text-gray-600 mb-4 text-sm">Use the Smart Buying Guide to build a configuration for your site, then send it to an authorized reseller for a local quote.</p>
          <a href="/guide/" class="inline-flex items-center px-5 py-2.5 rounded-lg bg-[#00529B] hover:bg-[#003d73] text-white font-semibold text-sm transition-colors">Build your system →</a>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-3 text-sm">
          <a href="/blog/" class="font-semibold text-[#00529B] hover:underline">← Back to Weather Notes</a>
          <a href="/blog/rss.xml" class="font-semibold text-[#00529B] hover:underline">RSS feed</a>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="py-12 bg-gray-50 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl font-bold mb-6">More in {post.category}</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {related.map((item) => <BlogCard post={item} />)}
          </div>
        </div>
      </section>
    )}
  </Layout>
) : (
  <Layout title="Post Not Found" description="The requested Weather Notes post could not be found.">
    <section class="py-24">
      <div class="max-w-xl mx-auto px-4 text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-[#C2410C] mb-3">404</p>
        <h1 class="text-3xl font-bold mb-3">Post not found</h1>
        <p class="text-gray-600 mb-6">This story may not be published yet, or the link may be out of date.</p>
        <a href="/blog/" class="inline-flex px-5 py-2.5 rounded-lg bg-[#00529B] text-white font-semibold">Browse Weather Notes</a>
      </div>
    </section>
  </Layout>
)}
