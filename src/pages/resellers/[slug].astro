---
import Layout from '../../layouts/Layout.astro';
import { resellers } from '../../data/resellers';
import { getCountryPage, countrySlug } from '../../utils/countries';

export function getStaticPaths() {
  return resellers.map((reseller) => ({
    params: { slug: reseller.slug },
    props: { reseller },
  }));
}

const { reseller } = Astro.props;
const countryPage = getCountryPage(countrySlug(reseller.country));
const relatedResellers = resellers
  .filter((item) => item.country === reseller.country && item.slug !== reseller.slug)
  .slice(0, 4);

const site = 'https://davisweatherstation.com';
const resellerUrl = `${site}/resellers/${reseller.slug}/`;
const shortLocation = reseller.city || reseller.country;
const location = reseller.city ? `${reseller.city}, ${reseller.country}` : reseller.country;
const nameFirstTitle = `${reseller.name} — Davis Reseller in ${shortLocation}`;
const metaTitle =
  nameFirstTitle.length <= 65 ? nameFirstTitle : `Davis Reseller in ${shortLocation} — ${reseller.name}`;
const metaDescription = `${reseller.name} is an authorized Davis Instruments reseller in ${location}. See contact details for weather stations and sensors.`;

const businessSchema = {
  '@type': 'LocalBusiness',
  name: reseller.name,
  url: reseller.website || resellerUrl,
  description: reseller.description || reseller.services || `Authorized Davis Instruments reseller in ${location}.`,
  ...(reseller.email ? { email: reseller.email } : {}),
  ...(reseller.phone ? { telephone: reseller.phone } : {}),
  ...(reseller.address
    ? { address: { '@type': 'PostalAddress', streetAddress: reseller.address, addressCountry: reseller.country } }
    : {}),
  areaServed: reseller.country,
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Resellers', item: `${site}/resellers/` },
    { '@type': 'ListItem', position: 3, name: reseller.name, item: resellerUrl },
  ],
};

const schema = { '@context': 'https://schema.org', '@graph': [businessSchema, breadcrumbSchema] };
---

<Layout title={metaTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-600">
        <a href="/" class="hover:text-[#00529B]">Home</a>
        <span>/</span>
        <a href="/resellers/" class="hover:text-[#00529B]">Resellers</a>
        <span>/</span>
        <span class="text-gray-900 font-medium">{reseller.name}</span>
      </nav>

      <!-- Header -->
      <div class="bg-gradient-to-br from-[#00529B] to-[#003d73] rounded-2xl p-8 md:p-10 text-white mb-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div>
            <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur rounded-full text-sm font-medium mb-4">
              {location}
            </span>
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4">{reseller.name}</h1>
            {reseller.resellerSince && (
              <p class="text-blue-100 text-lg">Authorized Reseller Since {reseller.resellerSince}</p>
            )}
          </div>
          {reseller.website && (
            <a href={reseller.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-white text-[#00529B] px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors self-start">
              Visit Website
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
          <section class="bg-white border border-gray-200 rounded-xl p-6 md:p-8">
            <h2 class="text-2xl font-bold mb-4">About</h2>
            <div class="text-gray-700 leading-relaxed space-y-4">
              {reseller.about ? (
                reseller.about.split('\n\n').map((paragraph, idx) => (
                  <p key={idx}>{paragraph}</p>
                ))
              ) : reseller.description ? (
                <p>{reseller.description}</p>
              ) : (
                <p>
                  {reseller.name} is listed as an authorized Davis Instruments reseller for {location}.
                  Use the contact details on this page to reach the dealer directly for product availability
                  and local support.
                </p>
              )}
              <p>
                This independent directory is not affiliated with Davis Instruments and does not sell products
                directly. Availability, delivery, and service terms are set by each reseller.
              </p>
            </div>
          </section>

          {(reseller.services || reseller.products) && (
            <section class="bg-white border border-gray-200 rounded-xl p-6 md:p-8">
              <h2 class="text-2xl font-bold mb-4">Services & Products</h2>
              {reseller.services && (
                <p class="text-gray-700 leading-relaxed mb-4">{reseller.services}</p>
              )}
              {reseller.products && reseller.products.length > 0 && (
                <div class="mb-4">
                  <h3 class="text-lg font-semibold mb-2 text-gray-900">Davis Instruments Products Carried</h3>
                  <ul class="list-disc list-inside space-y-1 text-gray-700">
                    {reseller.products.map((product, idx) => (
                      <li key={idx}>{product}</li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )}

          {(reseller.designations && reseller.designations.length > 0) || (reseller.certifications && reseller.certifications.length > 0) ? (
            <section class="bg-white border border-gray-200 rounded-xl p-6 md:p-8">
              <h2 class="text-2xl font-bold mb-4">Certifications & Designations</h2>
              {reseller.designations && reseller.designations.length > 0 && (
                <div class="mb-4">
                  <h3 class="text-lg font-semibold mb-2 text-gray-900">Authorized Designations</h3>
                  <ul class="list-disc list-inside space-y-1 text-gray-700">
                    {reseller.designations.map((designation, idx) => (
                      <li key={idx}>{designation}</li>
                    ))}
                  </ul>
                </div>
              )}
              {reseller.certifications && reseller.certifications.length > 0 && (
                <div>
                  <h3 class="text-lg font-semibold mb-2 text-gray-900">Certifications</h3>
                  <ul class="list-disc list-inside space-y-1 text-gray-700">
                    {reseller.certifications.map((cert, idx) => (
                      <li key={idx}>{cert}</li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          ) : null}

          {reseller.additionalInfo && (
            <section class="bg-white border border-gray-200 rounded-xl p-6 md:p-8">
              <h2 class="text-2xl font-bold mb-4">Additional Information</h2>
              <div class="text-gray-700 leading-relaxed space-y-4">
                {reseller.additionalInfo.split('\n\n').map((paragraph, idx) => (
                  <p key={idx}>{paragraph}</p>
                ))}
              </div>
            </section>
          )}

          <section class="bg-gradient-to-br from-blue-50 to-white border border-blue-100 rounded-xl p-6 md:p-8">
            <h2 class="text-2xl font-bold mb-4 text-[#00529B]">Davis Instruments Products</h2>
            <p class="text-gray-700 mb-4">
              This authorized reseller carries Davis Instruments weather monitoring equipment including Vantage Pro2, Vantage Vue, EnviroMonitor, and a wide range of sensors and accessories.
            </p>
            <a href="/products/" class="inline-flex items-center text-[#00529B] hover:text-[#003d73] font-semibold">
              View All Davis Products
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </section>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <section class="bg-white border border-gray-200 rounded-xl p-6">
            <h3 class="text-xl font-bold mb-4">Contact Information</h3>
            <div class="space-y-4">
              {reseller.address && (
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-[#00529B] mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900 mb-1">Address</p>
                    <p class="text-gray-600 text-sm">{reseller.address}</p>
                    <button type="button" data-copy={reseller.address} class="mt-1 text-xs font-semibold text-[#00529B] hover:underline" aria-label="Copy address">Copy</button>
                  </div>
                </div>
              )}
              
              {reseller.phone && (
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-[#00529B] mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900 mb-1">Phone</p>
                    <p class="text-gray-600 text-sm">{reseller.phone}</p>
                    <button type="button" data-copy={reseller.phone} class="mt-1 text-xs font-semibold text-[#00529B] hover:underline" aria-label="Copy phone number">Copy</button>
                  </div>
                </div>
              )}
              
              {reseller.telephone && reseller.telephone !== reseller.phone && (
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-[#00529B] mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900 mb-1">Mobile</p>
                    <p class="text-gray-600 text-sm">{reseller.telephone}</p>
                    <button type="button" data-copy={reseller.telephone} class="mt-1 text-xs font-semibold text-[#00529B] hover:underline" aria-label="Copy mobile number">Copy</button>
                  </div>
                </div>
              )}
              
              {reseller.email && (
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-[#00529B] mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900 mb-1">Email</p>
                    <a href={`mailto:${reseller.email}`} class="text-[#00529B] hover:underline text-sm">{reseller.email}</a>
                    <button type="button" data-copy={reseller.email} class="mt-1 block text-xs font-semibold text-[#00529B] hover:underline" aria-label="Copy email address">Copy</button>
                  </div>
                </div>
              )}
              
              {reseller.website && (
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-[#00529B] mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900 mb-1">Website</p>
                    <a href={reseller.website} target="_blank" rel="noopener noreferrer" class="text-[#00529B] hover:underline text-sm break-all">{reseller.website}</a>
                  </div>
                </div>
              )}
            </div>
          </section>

          <section class="bg-white border border-gray-200 rounded-xl p-6">
            <h3 class="text-xl font-bold mb-3">Location & Info</h3>
            <div class="flex items-center text-gray-700 mb-3">
              <svg class="w-5 h-5 text-[#00529B] mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="font-medium">{reseller.country}</span>
            </div>
            {reseller.resellerSince && (
              <div class="flex items-center text-gray-700 mb-3">
                <svg class="w-5 h-5 text-[#00529B] mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="font-medium">Authorized Reseller Since {reseller.resellerSince}</span>
              </div>
            )}
            <div class="flex items-center text-gray-700 mb-3">
              <svg class="w-5 h-5 text-[#C2410C] mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <span class="font-medium"><span id="page-views" class="inline-block min-w-[2ch] animate-pulse text-gray-300">--</span> page views</span>
            </div>
            {reseller.updatedAt && (
              <div class="pt-3 border-t border-gray-100">
                <p class="text-xs text-gray-500">Reseller information last updated</p>
                <p class="text-sm text-gray-700 font-medium">{reseller.updatedAt}</p>
              </div>
            )}
          </section>

          <a href="/resellers/" class="block w-full bg-gray-100 hover:bg-gray-200 text-gray-900 text-center px-6 py-3 rounded-lg font-semibold transition-colors">
            ← Back to All Resellers
          </a>
        </div>
      </div>

      {relatedResellers.length > 0 && (
        <section class="mt-12">
          <div class="flex items-center justify-between mb-5">
            <div>
              <h2 class="text-2xl font-bold">More Resellers in {reseller.country}</h2>
              {countryPage && (
                <a href={`/resellers/country/${countryPage.slug}/`} class="text-sm font-semibold text-[#00529B] hover:underline">View the {reseller.country} page →</a>
              )}
            </div>
            <a href="/resellers/" class="text-sm font-semibold text-[#00529B] hover:underline">View all</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {relatedResellers.map((item) => (
              <a href={`/resellers/${item.slug}/`} class="bg-white border border-gray-200 rounded-xl p-5 hover:shadow-lg hover:border-[#00529B]/40 transition-all group">
                <h3 class="font-bold text-gray-900 group-hover:text-[#00529B] transition-colors leading-snug">{item.name}</h3>
                <p class="text-sm text-gray-500 mt-2 line-clamp-2">{item.address || item.country}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>

  <script>
    const viewsEl = document.getElementById('page-views');
    const renderViews = (views) => {
      if (!viewsEl) return;
      viewsEl.classList.remove('animate-pulse', 'text-gray-300');
      viewsEl.classList.add('text-gray-700');
      viewsEl.textContent = Number(views).toLocaleString('en-US');
    };
    if (typeof window.__pageViews === 'number') renderViews(window.__pageViews);
    window.addEventListener('dws:page-views', (event) => renderViews(event.detail.views));
  </script>
</Layout>
