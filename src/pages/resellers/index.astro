---
import Layout from '../../layouts/Layout.astro';
import { resellers, countries } from '../../data/resellers';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Authorized Davis Instruments Resellers',
  numberOfItems: resellers.length,
  itemListElement: resellers.map((reseller, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: reseller.name,
    url: `https://davisweatherstation.com/resellers/${reseller.slug}/`,
  })),
};

const resellerLocations = resellers
  .filter((reseller) => typeof reseller.latitude === 'number' && typeof reseller.longitude === 'number')
  .map((reseller) => ({
    slug: reseller.slug,
    name: reseller.name,
    country: reseller.country,
    city: reseller.city || '',
    address: reseller.address || '',
    latitude: reseller.latitude as number,
    longitude: reseller.longitude as number,
    geoPrecision: reseller.geoPrecision || '',
  }));
---

<Layout title="Authorized Davis Instruments Resellers Worldwide" description="Browse authorized Davis Instruments resellers by country, with contact details, designations, local support, and installation services.">
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <section class="py-10 bg-gradient-to-br from-slate-50 via-blue-50 to-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <div class="inline-flex items-center px-4 py-2 bg-blue-100 text-[#00529B] rounded-full text-sm font-semibold mb-4">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
          </svg>
          Global Network
        </div>
        <h1 class="text-5xl md:text-6xl font-bold mb-4 bg-gradient-to-r from-[#00529B] to-[#003d73] bg-clip-text text-transparent">
          Authorized Resellers
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-3">
          Find authorized Davis Instruments dealers in your region. Get expert advice, installation, and support.
        </p>
        <p class="text-sm text-gray-500">
          Sourced from <a href="https://www.davisinstruments.com/pages/reseller" target="_blank" rel="noopener noreferrer" class="text-[#00529B] hover:underline font-medium">Davis Instruments official reseller network</a> • <span id="reseller-count" class="font-semibold text-[#00529B]">{resellers.length}</span> resellers worldwide
        </p>
        <a href="/resellers/countries/" class="inline-flex items-center mt-3 text-sm font-semibold text-[#00529B] hover:underline">Browse by country →</a>
      </div>

      <!-- Location-based reseller finder -->
      <div class="max-w-3xl mx-auto mb-8">
        <div class="bg-white border-2 border-blue-100 rounded-2xl p-5 sm:p-6 shadow-lg">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-[#00529B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Find resellers near you
              </h2>
              <p class="text-sm text-gray-600 mt-1">Use your browser location to see the closest authorized resellers. Your coordinates stay on your device.</p>
            </div>
            <button
              id="find-nearby"
              type="button"
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-[#00529B] hover:bg-[#003d73] text-white font-semibold text-sm transition-colors shadow-md focus:outline-none focus:ring-2 focus:ring-[#00529B] focus:ring-offset-2 whitespace-nowrap"
              aria-describedby="nearby-privacy"
            >
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s7-5.686 7-11a7 7 0 10-14 0c0 5.314 7 11 7 11z" />
                <circle cx="12" cy="10" r="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
              </svg>
              <span id="find-nearby-label">Use my location</span>
            </button>
          </div>
          <p id="nearby-privacy" class="text-xs text-gray-500 mt-2">Location access is optional. We use it only to calculate distance and do not store it.</p>
          <p id="nearby-status" class="text-sm text-gray-600 mt-3" role="status" aria-live="polite"></p>
          <div id="nearby-results" class="mt-4 grid gap-3 md:grid-cols-3 hidden" aria-live="polite"></div>
          <noscript>
            <p class="text-xs text-gray-500 mt-2">JavaScript is required for location-based results. You can still search or browse by country below.</p>
          </noscript>
        </div>
      </div>

      <!-- Search and Controls -->
      <div class="mb-6 space-y-4">
        <div class="relative max-w-2xl mx-auto">
          <div class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="reseller-search" aria-label="Search resellers by name, city, address, or country"
            placeholder="Search by name, city, address, or country..."
            class="w-full pl-12 pr-4 py-4 border-2 border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-[#00529B] focus:border-transparent shadow-lg hover:shadow-xl transition-all bg-white"
          />
        </div>

        <!-- Mobile Country Selector -->
        <div class="lg:hidden">
          <label for="mobile-country-select" class="sr-only">Filter resellers by country</label>
          <select id="mobile-country-select" aria-label="Filter resellers by country" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#00529B]">
            <option value="all">All Countries ({resellers.length})</option>
            {countries.map((country) => {
              const count = resellers.filter(r => r.country === country).length;
              return <option value={country}>{country} ({count})</option>;
            })}
          </select>
        </div>
      </div>

      <div class="lg:grid lg:grid-cols-12 lg:gap-6">
        <!-- Sticky Country Index Sidebar -->
        <aside class="hidden lg:block lg:col-span-3">
          <div class="sticky top-20 bg-white border-2 border-gray-100 rounded-2xl shadow-xl p-5 max-h-[calc(100vh-6rem)] overflow-y-auto">
            <h2 class="text-lg font-bold mb-4 text-gray-900 flex items-center">
              <svg class="w-5 h-5 mr-2 text-[#00529B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Jump to Country
            </h2>
            <nav class="space-y-1">
              <button class="country-jump w-full text-left px-3 py-2.5 rounded-xl hover:bg-gradient-to-r hover:from-blue-50 hover:to-white hover:text-[#00529B] transition-all text-sm font-semibold bg-gradient-to-r from-[#00529B] to-[#003d73] text-white" data-country="all">
                All Countries <span class="float-right bg-white/20 px-2 py-0.5 rounded-full text-xs">({resellers.length})</span>
              </button>
              {countries.map((country) => {
                const count = resellers.filter(r => r.country === country).length;
                return (
                  <button class="country-jump w-full text-left px-3 py-2 rounded-xl hover:bg-gradient-to-r hover:from-blue-50 hover:to-white hover:text-[#00529B] transition-all text-sm" data-country={country}>
                    {country} <span class="float-right text-gray-400 text-xs">({count})</span>
                  </button>
                );
              })}
            </nav>
            <button id="back-to-top" class="w-full mt-4 px-3 py-2.5 bg-gray-100 hover:bg-gray-200 rounded-xl text-sm font-semibold transition-all hover:shadow-md">
              ↑ Back to Top
            </button>
          </div>
        </aside>

        <!-- Resellers Content -->
        <main class="lg:col-span-9">
          <div id="resellers-container" class="space-y-10">
            {countries.map((country) => {
              const countryResellers = resellers.filter(r => r.country === country);
              return (
                <section class="country-section" data-country={country} id={`country-${country.replace(/\s+/g, '-').toLowerCase()}`}>
                  <div class="sticky top-16 bg-gradient-to-r from-white via-blue-50/50 to-white backdrop-blur border-b-2 border-[#00529B] pb-3 mb-6 z-10 rounded-t-xl px-4 py-3">
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 flex items-center gap-3">
                      <span class="text-3xl">{country === 'United States' ? '🇺🇸' : country === 'United Kingdom' ? '🇬🇧' : country === 'Canada' ? '🇨🇦' : country === 'Australia' ? '🇦🇺' : country === 'Philippines' ? '🇵🇭' : '🌍'}</span>
                      {country}
                      <span class="px-4 py-1.5 bg-gradient-to-r from-[#00529B] to-[#003d73] text-white text-sm rounded-full font-bold shadow-md">
                        {countryResellers.length}
                      </span>
                    </h2>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    {countryResellers.map((reseller) => (
                      <article class="reseller-card bg-white border-2 border-gray-100 rounded-2xl p-6 hover:shadow-2xl hover:border-[#00529B]/50 transition-all group relative overflow-hidden" data-country={reseller.country} data-name={reseller.name.toLowerCase()} data-search={`${reseller.name.toLowerCase()} ${reseller.country.toLowerCase()} ${reseller.address?.toLowerCase() || ''} ${reseller.city?.toLowerCase() || ''}`}>
                        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#00529B]/5 to-transparent rounded-bl-full"></div>
                        <div class="relative">
                          <div class="flex items-start justify-between mb-4">
                            <h3 class="text-xl font-bold text-gray-900 group-hover:text-[#00529B] transition-colors leading-tight flex-1 pr-2">
                              {reseller.name}
                            </h3>
                            {reseller.resellerSince && (
                              <span class="px-2 py-1 bg-green-50 text-green-700 text-xs rounded-full font-medium whitespace-nowrap">
                                Since {reseller.resellerSince}
                              </span>
                            )}
                          </div>
                          
                          {reseller.address && (
                            <div class="mb-3 flex items-start">
                              <svg class="w-4 h-4 text-[#00529B] mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                              </svg>
                              <p class="text-gray-600 text-sm line-clamp-2">{reseller.address}</p>
                            </div>
                          )}
                          
                          {reseller.phone && (
                            <div class="mb-2 flex items-center">
                              <svg class="w-4 h-4 text-[#00529B] mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                              </svg>
                              <p class="text-gray-600 text-sm font-medium">{reseller.phone}</p>
                            </div>
                          )}
                          
                          {reseller.services && (
                            <div class="mb-3 p-2 bg-blue-50/50 rounded-lg">
                              <p class="text-xs text-gray-700 line-clamp-2">{reseller.services}</p>
                            </div>
                          )}
                          
                          <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-100">
                            <a href={`/resellers/${reseller.slug}/`} class="btn-shimmer inline-flex items-center px-4 py-2 bg-gradient-to-r from-[#00529B] to-[#003d73] hover:from-[#003d73] hover:to-[#002a52] text-white rounded-lg font-semibold text-sm transition-all shadow-md hover:shadow-lg">
                              View Details
                              <svg class="w-4 h-4 ml-1.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                              </svg>
                            </a>
                            {reseller.website && (
                              <a href={reseller.website} data-outbound="reseller" target="_blank" rel="noopener noreferrer" class="p-2 text-gray-400 hover:text-[#00529B] hover:bg-blue-50 rounded-lg transition-all" title="Visit website">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                              </a>
                            )}
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                  {countryResellers.length > 9 && (
                    <div class="mt-5 text-center">
                      <button
                        type="button"
                        class="show-more-country px-5 py-2.5 rounded-lg border-2 border-[#00529B] text-[#00529B] hover:bg-[#00529B] hover:text-white text-sm font-semibold transition-colors"
                        data-country={country}
                        data-total={countryResellers.length}
                      >
                        Show all {countryResellers.length} resellers
                      </button>
                    </div>
                  )}
                </section>
              );
            })}
          </div>

          <div id="no-results" class="hidden text-center py-12">
            <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-gray-500 text-lg mb-2">No resellers found</p>
            <p class="text-gray-400 text-sm">Try adjusting your search or filter</p>
          </div>
        </main>
      </div>
    </div>
  </section>

  <!-- Back to Top Button (Floating) -->
  <button id="back-to-top-float" type="button" aria-label="Back to top" class="fixed bottom-6 right-6 bg-[#00529B] hover:bg-[#003d73] text-white p-3 rounded-full shadow-xl transition-all opacity-0 pointer-events-none z-50">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <script type="application/json" id="reseller-locations" set:html={JSON.stringify(resellerLocations).replace(/</g, '\\u003c')}></script>

  <script>
    const searchInput = document.getElementById('reseller-search');
    const resellerCards = document.querySelectorAll('.reseller-card');
    const countrySections = document.querySelectorAll('.country-section');
    const countryJumps = document.querySelectorAll('.country-jump');
    const mobileSelect = document.getElementById('mobile-country-select');
    const noResults = document.getElementById('no-results');
    const resellerCount = document.getElementById('reseller-count');
    const backToTop = document.getElementById('back-to-top');
    const backToTopFloat = document.getElementById('back-to-top-float');

    let currentFilter = 'all';
    let currentSearch = '';
    const expandedCountries = new Set();
    const COUNTRY_LIMIT = 9;

    function filterResellers() {
      let visibleCount = 0;
      
      const matchedCounts = new Map();
      resellerCards.forEach(card => {
        const cardCountry = card.getAttribute('data-country');
        const cardSearch = card.getAttribute('data-search') || '';
        
        const matchesCountry = currentFilter === 'all' || cardCountry === currentFilter;
        const matchesSearch = currentSearch === '' || cardSearch.includes(currentSearch.toLowerCase());
        
        if (matchesCountry && matchesSearch) {
          const country = cardCountry || '';
          const seen = matchedCounts.get(country) || 0;
          matchedCounts.set(country, seen + 1);
          const limited = currentFilter === 'all' && currentSearch === '' && !expandedCountries.has(country);
          if (limited && seen >= COUNTRY_LIMIT) {
            card.style.display = 'none';
          } else {
            card.style.display = 'block';
            visibleCount++;
          }
        } else {
          card.style.display = 'none';
        }
      });

      // Hide/show country sections
      countrySections.forEach(section => {
        const sectionCountry = section.getAttribute('data-country');
        const sectionCards = section.querySelectorAll('.reseller-card');
        let sectionVisible = 0;
        
        sectionCards.forEach(card => {
          if (card.style.display !== 'none') sectionVisible++;
        });
        
        if (currentFilter === 'all' && currentSearch === '') {
          section.style.display = 'block';
        } else if (currentFilter !== 'all' && sectionCountry !== currentFilter) {
          section.style.display = 'none';
        } else if (sectionVisible === 0) {
          section.style.display = 'none';
        } else {
          section.style.display = 'block';
        }
      });

      // Update count
      if (resellerCount) {
        resellerCount.textContent = visibleCount.toString();
      }

      // Show/hide no results
      if (visibleCount === 0) {
        noResults?.classList.remove('hidden');
      } else {
        noResults?.classList.add('hidden');
      }
    }

    // Per-country progressive disclosure
    document.querySelectorAll('.show-more-country').forEach(btn => {
      btn.addEventListener('click', () => {
        const country = btn.getAttribute('data-country') || '';
        const total = btn.getAttribute('data-total') || '0';
        if (expandedCountries.has(country)) {
          expandedCountries.delete(country);
          btn.textContent = `Show all ${total} resellers`;
        } else {
          expandedCountries.add(country);
          btn.textContent = 'Show fewer resellers';
        }
        filterResellers();
      });
    });

    // Search
    let searchDebounce;
    searchInput?.addEventListener('input', (e) => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        currentSearch = e.target.value;
        filterResellers();
      }, 200);
    });

    // Country jump buttons
    countryJumps.forEach(btn => {
      btn.addEventListener('click', () => {
        const country = btn.getAttribute('data-country');
        currentFilter = country;
        
        // Update button styles
        countryJumps.forEach(b => {
          b.classList.remove('bg-[#00529B]', 'text-white');
          b.classList.add('hover:bg-blue-50', 'hover:text-[#00529B]');
        });
        btn.classList.add('bg-[#00529B]', 'text-white');
        btn.classList.remove('hover:bg-blue-50', 'hover:text-[#00529B]');
        
        // Update mobile select
        if (mobileSelect) {
          mobileSelect.value = country;
        }
        
        filterResellers();
        
        // Scroll to section if not 'all'
        if (country !== 'all') {
          const sectionId = `country-${country.replace(/\s+/g, '-').toLowerCase()}`;
          const section = document.getElementById(sectionId);
          if (section) {
            const offset = 100;
            const top = section.getBoundingClientRect().top + window.pageYOffset - offset;
            window.scrollTo({ top, behavior: 'smooth' });
          }
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });

    // Mobile select
    mobileSelect?.addEventListener('change', (e) => {
      const country = e.target.value;
      currentFilter = country;
      
      countryJumps.forEach(btn => {
        if (btn.getAttribute('data-country') === country) {
          btn.classList.add('bg-[#00529B]', 'text-white');
          btn.classList.remove('hover:bg-blue-50', 'hover:text-[#00529B]');
        } else {
          btn.classList.remove('bg-[#00529B]', 'text-white');
          btn.classList.add('hover:bg-blue-50', 'hover:text-[#00529B]');
        }
      });
      
      filterResellers();
      
      if (country !== 'all') {
        const sectionId = `country-${country.replace(/\s+/g, '-').toLowerCase()}`;
        const section = document.getElementById(sectionId);
        if (section) {
          const offset = 120;
          const top = section.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      }
    });

    // Back to top
    backToTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    backToTopFloat?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    filterResellers();

    // Show/hide floating back to top
    window.addEventListener('scroll', () => {
      if (window.pageYOffset > 300) {
        backToTopFloat?.classList.remove('opacity-0', 'pointer-events-none');
        backToTopFloat?.classList.add('opacity-100');
      } else {
        backToTopFloat?.classList.add('opacity-0', 'pointer-events-none');
        backToTopFloat?.classList.remove('opacity-100');
      }
    });
  </script>

  <script>
    const nearbyDataEl = document.getElementById('reseller-locations');
    const nearbyData = nearbyDataEl ? JSON.parse(nearbyDataEl.textContent || '[]') : [];
    const findNearbyBtn = document.getElementById('find-nearby');
    const findNearbyLabel = document.getElementById('find-nearby-label');
    const nearbyStatus = document.getElementById('nearby-status');
    const nearbyResults = document.getElementById('nearby-results');

    function nearbyDistanceKm(lat1, lon1, lat2, lon2) {
      const radius = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2)
        + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180)
        * Math.sin(dLon / 2) * Math.sin(dLon / 2);
      return 2 * radius * Math.asin(Math.min(1, Math.sqrt(a)));
    }

    function nearbyFormatDistance(km) {
      const miles = km * 0.621371;
      if (km < 10) {
        return `${km.toFixed(1)} km (${miles.toFixed(1)} mi)`;
      }
      return `${Math.round(km).toLocaleString('en-US')} km (${Math.round(miles).toLocaleString('en-US')} mi)`;
    }

    function nearbySetBusy(isBusy) {
      if (!findNearbyBtn) return;
      findNearbyBtn.disabled = isBusy;
      findNearbyBtn.classList.toggle('opacity-70', isBusy);
      findNearbyBtn.classList.toggle('cursor-wait', isBusy);
      if (findNearbyLabel) findNearbyLabel.textContent = isBusy ? 'Finding location…' : 'Use my location';
    }

    function nearbyShowError(message) {
      nearbySetBusy(false);
      if (nearbyStatus) nearbyStatus.textContent = message;
      nearbyResults?.classList.add('hidden');
    }

    function nearbyRender(position) {
      const originLat = position.coords.latitude;
      const originLng = position.coords.longitude;
      const ranked = nearbyData
        .map((reseller) => ({
          ...reseller,
          distance: nearbyDistanceKm(originLat, originLng, reseller.latitude, reseller.longitude),
        }))
        .sort((a, b) => a.distance - b.distance)
        .slice(0, 3);

      if (!nearbyResults) return;
      nearbyResults.replaceChildren();

      ranked.forEach((reseller, index) => {
        const card = document.createElement('article');
        card.className = 'rounded-xl border border-gray-200 bg-gray-50 p-4 flex flex-col';

        const heading = document.createElement('div');
        heading.className = 'flex items-start gap-2';

        const badge = document.createElement('span');
        badge.className = index === 0
          ? 'inline-flex shrink-0 items-center rounded-full bg-green-100 px-2 py-0.5 text-[11px] font-bold text-green-800'
          : 'inline-flex shrink-0 items-center rounded-full bg-blue-100 px-2 py-0.5 text-[11px] font-bold text-[#00529B]';
        badge.textContent = index === 0 ? 'Nearest' : `#${index + 1}`;
        heading.appendChild(badge);

        const name = document.createElement('h3');
        name.className = 'text-sm font-bold text-gray-900 leading-snug';
        name.textContent = reseller.name;
        heading.appendChild(name);
        card.appendChild(heading);

        const location = document.createElement('p');
        location.className = 'mt-2 text-xs text-gray-500';
        location.textContent = [reseller.city, reseller.country].filter(Boolean).join(', ') || reseller.country;
        card.appendChild(location);

        if (reseller.address) {
          const address = document.createElement('p');
          address.className = 'mt-1 text-xs text-gray-400 line-clamp-2';
          address.textContent = reseller.address;
          card.appendChild(address);
        }

        const distance = document.createElement('p');
        distance.className = 'mt-3 text-xs font-semibold text-[#00529B]';
        distance.textContent = nearbyFormatDistance(reseller.distance);
        card.appendChild(distance);

        const link = document.createElement('a');
        link.href = `/resellers/${encodeURIComponent(reseller.slug)}/`;
        link.className = 'mt-3 inline-flex items-center text-sm font-semibold text-[#00529B] hover:underline';
        link.textContent = 'View details';
        const arrow = document.createElement('span');
        arrow.className = 'ml-1';
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '→';
        link.appendChild(arrow);
        card.appendChild(link);

        nearbyResults.appendChild(card);
      });

      nearbyResults.classList.remove('hidden');
      nearbySetBusy(false);

      if (nearbyStatus) {
        const nearest = ranked[0];
        const approximate = ranked.some((reseller) => reseller.geoPrecision && reseller.geoPrecision !== 'address');
        let message = nearest && nearest.distance > 300
          ? 'No resellers are close to your location. These are the three closest available. Confirm service coverage with the reseller.'
          : 'Showing the three closest resellers. Distances are straight-line; confirm service coverage with the reseller.';
        if (approximate) {
          message += ' Some distances are approximate to the city level.';
        }
        nearbyStatus.textContent = message;
      }
    }

    findNearbyBtn?.addEventListener('click', () => {
      if (!nearbyData.length) {
        nearbyShowError('Location data is not available right now. Use the search or country list.');
        return;
      }
      if (!('geolocation' in navigator)) {
        nearbyShowError('Your browser does not support location access. Use the search or country list.');
        return;
      }

      nearbySetBusy(true);
      if (nearbyStatus) nearbyStatus.textContent = 'Getting your location…';
      nearbyResults?.classList.add('hidden');

      navigator.geolocation.getCurrentPosition(
        nearbyRender,
        (error) => {
          if (error.code === error.PERMISSION_DENIED) {
            nearbyShowError('Location access was denied. You can search by city or browse by country.');
          } else if (error.code === error.POSITION_UNAVAILABLE) {
            nearbyShowError('We could not determine your location. Try again or use the search.');
          } else if (error.code === error.TIMEOUT) {
            nearbyShowError('The location request timed out. Try again or use the search.');
          } else {
            nearbyShowError('Location is unavailable. Use the search or country list.');
          }
        },
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
      );
    });
  </script>
</Layout>
