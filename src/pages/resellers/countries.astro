---
import Layout from '../../layouts/Layout.astro';
import { countryGroups, countryPages } from '../../utils/countries';
import { resellers } from '../../data/resellers';

const site = 'https://davisweatherstation.com';
const pageUrl = `${site}/resellers/countries/`;
const pageSlugs = new Set(countryPages.map((country) => country.slug));
const sortedCountries = [...countryGroups].sort((a, b) => a.name.localeCompare(b.name));
const countryCount = countryGroups.length;
const singleCount = countryGroups.filter((country) => country.count === 1).length;

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Resellers', item: `${site}/resellers/` },
    { '@type': 'ListItem', position: 3, name: 'Countries', item: pageUrl },
  ],
};

const itemListSchema = {
  '@type': 'ItemList',
  name: 'Davis Instruments resellers by country',
  numberOfItems: countryCount,
  itemListElement: sortedCountries.map((country, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: country.name,
    url: pageSlugs.has(country.slug)
      ? `${site}/resellers/country/${country.slug}/`
      : country.count === 1
        ? `${site}/resellers/${country.resellers[0].slug}/`
        : `${site}/resellers/`,
  })),
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Davis Instruments Resellers by Country',
      description: `Browse ${resellers.length} authorized Davis Instruments resellers across ${countryCount} countries.`,
      url: pageUrl,
    },
    breadcrumbSchema,
    itemListSchema,
  ],
};
---

<Layout
  title="Davis Instruments Resellers by Country"
  description={`Browse ${resellers.length} authorized Davis Instruments resellers across ${countryCount} countries, grouped by country with contact details and dealer pages.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="bg-gradient-to-br from-[#00529B] to-[#003d73] text-white py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-blue-100">
        <a href="/" class="hover:text-white">Home</a>
        <span class="text-blue-300">/</span>
        <a href="/resellers/" class="hover:text-white">Resellers</a>
        <span class="text-blue-300">/</span>
        <span class="text-white font-medium">Countries</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Davis Instruments Resellers by Country</h1>
      <p class="text-lg text-blue-100 max-w-3xl">
        Find an authorized dealer near you. We list {resellers.length} resellers across {countryCount} countries,
        with contact details, locations, and dealer services.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
          <h2 class="text-3xl font-bold">Browse by country</h2>
          <p class="text-gray-600 mt-2">
            Countries with a single listing link directly to that reseller. Countries with two or more have a dedicated dealer page.
          </p>
        </div>
        <div class="w-full sm:w-72">
          <label for="country-filter" class="sr-only">Filter countries</label>
          <input
            id="country-filter"
            type="search"
            placeholder="Filter countries…"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#00529B]"
            autocomplete="off"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="country-grid">
        {sortedCountries.map((country) => (
          <article class="country-card bg-white border border-gray-200 rounded-xl p-5 hover:shadow-lg hover:border-[#00529B]/40 transition-all" data-country={country.name.toLowerCase()}>
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-bold text-gray-900">
                  {pageSlugs.has(country.slug) ? (
                    <a href={`/resellers/country/${country.slug}/`} class="hover:text-[#00529B] transition-colors">{country.name}</a>
                  ) : country.count === 1 ? (
                    <a href={`/resellers/${country.resellers[0].slug}/`} class="hover:text-[#00529B] transition-colors">{country.name}</a>
                  ) : (
                    country.name
                  )}
                </h3>
                <p class="text-sm text-gray-500 mt-1">
                  {country.count} {country.count === 1 ? 'reseller' : 'resellers'}
                </p>
              </div>
              <span class="px-2.5 py-1 bg-blue-50 text-[#00529B] text-xs rounded-full font-semibold whitespace-nowrap">
                {country.count}
              </span>
            </div>
            <div class="mt-4 text-sm">
              {pageSlugs.has(country.slug) ? (
                <a href={`/resellers/country/${country.slug}/`} class="font-semibold text-[#00529B] hover:underline">View country page →</a>
              ) : country.count === 1 ? (
                <a href={`/resellers/${country.resellers[0].slug}/`} class="font-semibold text-[#00529B] hover:underline">View reseller →</a>
              ) : null}
            </div>
          </article>
        ))}
      </div>

      <p id="country-empty" class="hidden text-center text-gray-500 py-10">No countries match that filter.</p>

      <div class="mt-10 flex flex-col sm:flex-row gap-3">
        <a href="/resellers/" class="inline-flex justify-center px-5 py-3 rounded-lg bg-[#00529B] hover:bg-[#003d73] text-white font-semibold transition-colors">Browse all resellers</a>
        <a href="/guide/" class="inline-flex justify-center px-5 py-3 rounded-lg bg-white border-2 border-gray-200 hover:border-[#00529B] text-gray-800 font-semibold transition-colors">Start the buying guide</a>
      </div>
    </div>
  </section>

  <script>
    const input = document.getElementById('country-filter');
    const cards = Array.from(document.querySelectorAll('.country-card'));
    const empty = document.getElementById('country-empty');
    input?.addEventListener('input', () => {
      const term = (input.value || '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const match = !term || (card.getAttribute('data-country') || '').includes(term);
        card.style.display = match ? '' : 'none';
        if (match) visible += 1;
      });
      empty?.classList.toggle('hidden', visible > 0);
    });
  </script>
</Layout>
