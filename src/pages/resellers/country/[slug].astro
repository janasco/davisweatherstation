---
import Layout from '../../../layouts/Layout.astro';
import { countryPages } from '../../../utils/countries';
import { allProducts } from '../../../data/allProducts';
import { faqs } from '../../../data/faqs';

export function getStaticPaths() {
  return countryPages.map((country) => ({
    params: { slug: country.slug },
    props: { country },
  }));
}

const { country } = Astro.props;

const site = 'https://davisweatherstation.com';
const pageUrl = `${site}/resellers/country/${country.slug}/`;
const countLabel = `${country.count} ${country.count === 1 ? 'reseller' : 'resellers'}`;
const title = `Davis Instruments Resellers in ${country.name} — ${countLabel}`;
const description = `Find ${countLabel} for Davis Instruments weather stations in ${country.name}. Compare contact details, locations, and dealer services.`;

const featuredProducts = allProducts.filter((product) => product.curated).slice(0, 4);
const countryFaqs = ['find-reseller', 'contact-reseller', 'buy-direct', 'warranty']
  .map((id) => faqs.find((faq) => faq.id === id))
  .filter((faq) => Boolean(faq)) as typeof faqs;
const otherCountries = countryPages.filter((item) => item.slug !== country.slug).slice(0, 6);

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Resellers', item: `${site}/resellers/` },
    { '@type': 'ListItem', position: 3, name: 'Countries', item: `${site}/resellers/countries/` },
    { '@type': 'ListItem', position: 4, name: country.name, item: pageUrl },
  ],
};

const itemListSchema = {
  '@type': 'ItemList',
  name: `Davis Instruments resellers in ${country.name}`,
  numberOfItems: country.count,
  itemListElement: country.resellers.map((reseller, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: reseller.name,
    url: `${site}/resellers/${reseller.slug}/`,
  })),
};

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: countryFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(),
    },
  })),
};

const collectionSchema = {
  '@type': 'CollectionPage',
  name: title,
  description,
  url: pageUrl,
  isPartOf: { '@type': 'WebSite', name: 'Davis Weather Station', url: site },
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [collectionSchema, breadcrumbSchema, itemListSchema, faqSchema],
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="bg-gradient-to-br from-[#00529B] to-[#003d73] text-white py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-blue-100">
        <a href="/" class="hover:text-white">Home</a>
        <span class="text-blue-300">/</span>
        <a href="/resellers/" class="hover:text-white">Resellers</a>
        <span class="text-blue-300">/</span>
        <a href="/resellers/countries/" class="hover:text-white">Countries</a>
        <span class="text-blue-300">/</span>
        <span class="text-white font-medium">{country.name}</span>
      </nav>

      <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur rounded-full text-sm font-medium mb-4">
        {countLabel}
      </span>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Davis Instruments Resellers in {country.name}</h1>
      <p class="text-lg text-blue-100 max-w-3xl">
        Browse {countLabel} for Davis Instruments weather stations, sensors, and accessories in {country.name}.
        Each listing includes contact details, location, and the services offered by the dealer.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
          <h2 class="text-3xl font-bold">Resellers in {country.name}</h2>
          <p class="text-gray-600 mt-2">Contact a dealer directly for availability, delivery, and local support.</p>
        </div>
        <a href="/resellers/" class="text-sm font-semibold text-[#00529B] hover:underline">View all resellers →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {country.resellers.map((reseller) => (
          <article class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-xl hover:border-[#00529B]/40 transition-all">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="text-xl font-bold text-gray-900">
                <a href={`/resellers/${reseller.slug}/`} class="hover:text-[#00529B] transition-colors">{reseller.name}</a>
              </h3>
              <span class="px-3 py-1 bg-blue-50 text-[#00529B] text-sm rounded-full font-medium whitespace-nowrap">
                {reseller.city || country.name}
              </span>
            </div>

            {reseller.address && (
              <p class="text-gray-600 text-sm mb-3">{reseller.address}</p>
            )}

            {reseller.services && (
              <p class="text-gray-600 text-sm mb-4">{reseller.services}</p>
            )}

            <div class="flex flex-wrap items-center gap-4 text-sm">
              <a href={`/resellers/${reseller.slug}/`} class="font-semibold text-[#00529B] hover:underline">View details →</a>
              {reseller.website && (
                <a href={reseller.website} data-outbound="reseller" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-[#00529B] hover:underline">
                  Website
                </a>
              )}
              {reseller.phone && (
                <a href={`tel:${reseller.phone.replace(/[^+\d]/g, '')}`} class="text-gray-500 hover:text-[#00529B] hover:underline">
                  {reseller.phone}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
          <h2 class="text-3xl font-bold">Popular Davis products</h2>
          <p class="text-gray-600 mt-2">Start with these core systems, then ask a local reseller about sensors and accessories.</p>
        </div>
        <a href="/products/" class="text-sm font-semibold text-[#00529B] hover:underline">Browse the catalog →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <a href={`/products/${product.slug}/`} class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow group border border-gray-100">
            <div class="h-40 bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center overflow-hidden">
              {product.image ? (
                <img
                  src={product.image}
                  srcset={`${product.image.replace('.webp', '-400.webp')} 400w, ${product.image} 900w`}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 92vw"
                  alt={product.name}
                  class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="text-[#00529B] font-semibold px-4 text-center">{product.name}</span>
              )}
            </div>
            <div class="p-5">
              <span class="text-xs font-semibold text-[#C2410C] uppercase tracking-wide">{product.category}</span>
              <h3 class="text-lg font-bold text-gray-900 mt-2 group-hover:text-[#00529B] transition-colors">{product.name}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <h2 class="text-3xl font-bold mb-6">Buying a Davis station in {country.name}</h2>
        <div class="space-y-3">
          {countryFaqs.map((faq) => (
            <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 select-none">
                <h3 class="font-semibold text-gray-900 group-hover:text-[#00529B] transition-colors">{faq.question}</h3>
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-50 text-[#00529B] flex items-center justify-center transition-all group-open:rotate-180">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="px-5 pb-5 text-gray-600 leading-relaxed text-sm" set:html={faq.answer} />
            </details>
          ))}
        </div>
        <a href="/faq/" class="inline-flex items-center mt-6 text-sm font-semibold text-[#00529B] hover:underline">Read all FAQs →</a>
      </div>

      <aside class="space-y-6">
        <div class="bg-gradient-to-br from-[#00529B] to-[#003d73] rounded-2xl p-6 text-white">
          <h2 class="text-xl font-bold mb-2">Not sure which station fits?</h2>
          <p class="text-blue-100 text-sm mb-5">
            Answer seven questions and get a recommended configuration with matching SKUs, then send it to a {country.name} reseller.
          </p>
          <a href="/guide/" class="inline-block bg-[#C2410C] hover:bg-[#9a3412] text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-colors">
            Start the Buying Guide
          </a>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h2 class="text-lg font-bold mb-4">Other countries</h2>
          <ul class="space-y-2.5 text-sm">
            {otherCountries.map((item) => (
              <li>
                <a href={`/resellers/country/${item.slug}/`} class="text-[#00529B] hover:underline">
                  {item.name} <span class="text-gray-400">({item.count})</span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/resellers/countries/" class="inline-block mt-4 text-sm font-semibold text-[#00529B] hover:underline">All countries →</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
