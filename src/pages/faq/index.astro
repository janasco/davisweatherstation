---
import Layout from '../../layouts/Layout.astro';
import { faqs, faqCategories } from '../../data/faqs';

const plain = (html: string) => html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();

const grouped = faqCategories.map((category) => ({
  category,
  items: faqs.filter((f) => f.category === category),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: plain(f.answer),
    },
  })),
};
---

<Layout
  title="Frequently Asked Questions"
  description="Answers to common questions about Davis Instruments weather stations, resellers, installation, WeatherLink, sensors, maintenance, warranty and agriculture."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-[#00529B] via-[#003d73] to-[#001f3f] text-white overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-white/5 rounded-full -mr-48 -mt-48"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-[#C2410C]/10 rounded-full -ml-36 -mb-36"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 text-center">
      <div class="inline-flex items-center px-4 py-2 bg-white/10 backdrop-blur border border-white/20 rounded-full text-sm font-semibold mb-5">
        <svg class="w-4 h-4 mr-2 text-[#C2410C]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        Help Center
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-5 leading-tight">Frequently Asked Questions</h1>
      <p class="text-lg md:text-xl text-blue-100 max-w-2xl mx-auto mb-8">
        Everything customers ask about choosing, installing, connecting, and maintaining Davis Instruments weather stations.
      </p>

      <div class="relative max-w-2xl mx-auto">
        <svg class="absolute left-5 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="faq-search" aria-label="Search frequently asked questions"
          type="search"
          placeholder="Search questions, e.g. “Wi-Fi”, “battery”, “warranty”…"
          class="w-full pl-14 pr-5 py-4 rounded-2xl text-gray-900 bg-white shadow-2xl border-2 border-white/50 focus:outline-none focus:ring-4 focus:ring-[#FF6B35]/40 text-base"
          autocomplete="off"
        />
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-blue-100">
        <span><strong class="text-white">{faqs.length}</strong> answers</span>
        <span class="hidden sm:inline text-blue-300">•</span>
        <span><strong class="text-white">{faqCategories.length}</strong> categories</span>
        <span class="hidden sm:inline text-blue-300">•</span>
        <span>Updated regularly</span>
      </div>
    </div>
  </section>

  <section class="py-10 bg-gradient-to-br from-slate-50 via-blue-50 to-white min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Category chips -->
      <div class="mb-6 flex flex-wrap gap-2 justify-center" id="faq-filters">
        <button class="faq-filter active px-4 py-2 rounded-full text-sm font-semibold bg-[#00529B] text-white shadow-md transition-all" data-category="all">
          All ({faqs.length})
        </button>
        {grouped.map(({ category, items }) => (
          <button class="faq-filter px-4 py-2 rounded-full text-sm font-semibold bg-white text-gray-700 border-2 border-gray-200 hover:border-[#00529B]/50 hover:text-[#00529B] shadow-sm transition-all" data-category={category}>
            {category} ({items.length})
          </button>
        ))}
      </div>

      <!-- Utility row -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-8 px-1">
        <p class="text-sm text-gray-600">
          Showing <span id="faq-visible-count" class="font-semibold text-[#00529B]">{faqs.length}</span> of {faqs.length} questions
        </p>
        <div class="flex gap-2">
          <button id="faq-expand-all" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-gray-200 text-gray-700 hover:border-[#00529B] hover:text-[#00529B] transition-all shadow-sm">
            Expand all
          </button>
          <button id="faq-collapse-all" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-gray-200 text-gray-700 hover:border-[#00529B] hover:text-[#00529B] transition-all shadow-sm">
            Collapse all
          </button>
        </div>
      </div>

      <!-- Grouped FAQs -->
      <div id="faq-groups" class="space-y-10">
        {grouped.map(({ category, items }) => (
          <section class="faq-group" data-category={category} id={`faq-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
            <div class="flex items-center gap-3 mb-4">
              <h2 class="text-2xl font-bold text-gray-900">{category}</h2>
              <span class="px-2.5 py-1 bg-blue-50 text-[#00529B] text-xs font-bold rounded-full">{items.length}</span>
            </div>

            <div class="space-y-3">
              {items.map((faq) => (
                <details
                  class="faq-item group bg-white border-2 border-gray-100 rounded-2xl shadow-sm hover:shadow-md hover:border-[#00529B]/30 transition-all overflow-hidden"
                  data-question={faq.question.toLowerCase()}
                  data-answer={plain(faq.answer).toLowerCase()}
                >
                  <summary class="flex items-start justify-between gap-4 cursor-pointer list-none px-5 py-4 md:px-6 md:py-5 select-none">
                    <h3 class="font-semibold text-gray-900 group-hover:text-[#00529B] transition-colors text-base md:text-lg leading-snug">
                      {faq.question}
                    </h3>
                    <span class="faq-chevron flex-shrink-0 w-8 h-8 rounded-full bg-blue-50 text-[#00529B] flex items-center justify-center transition-all duration-300 group-open:rotate-180 group-open:bg-[#00529B] group-open:text-white">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-answer px-5 pb-5 md:px-6 md:pb-6 -mt-1 text-gray-600 leading-relaxed text-sm md:text-base" set:html={faq.answer} />
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- No results -->
      <div id="faq-no-results" class="hidden text-center py-16">
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <p class="text-lg font-semibold text-gray-700 mb-1">No questions matched your search</p>
        <p class="text-gray-500 text-sm mb-5">Try a different keyword, or ask us directly.</p>
        <a href="/contact/" class="inline-flex items-center px-5 py-2.5 bg-[#00529B] hover:bg-[#003d73] text-white rounded-lg font-semibold text-sm transition-colors">
          Contact Us
        </a>
      </div>

      <!-- CTA -->
      <div class="mt-14 bg-gradient-to-r from-[#00529B] to-[#003d73] rounded-3xl p-8 md:p-12 text-center text-white shadow-xl">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Still have questions?</h2>
        <p class="text-blue-100 mb-7 max-w-2xl mx-auto">
          Our reseller network can help with product selection, quotations, installation, and after-sales support.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/guide/" class="btn-shimmer px-6 py-3 bg-[#C2410C] hover:bg-[#9a3412] rounded-xl font-semibold transition-all shadow-lg">
            Use the Smart Buying Guide
          </a>
          <a href="/resellers/" class="px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/30 rounded-xl font-semibold transition-all">
            Find a Reseller
          </a>
          <a href="/contact/" class="px-6 py-3 bg-white text-[#00529B] hover:bg-blue-50 rounded-xl font-semibold transition-all">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('faq-search') as HTMLInputElement | null;
    const filters = Array.from(document.querySelectorAll('.faq-filter')) as HTMLElement[];
    const groups = Array.from(document.querySelectorAll('.faq-group')) as HTMLElement[];
    const items = Array.from(document.querySelectorAll('.faq-item')) as HTMLDetailsElement[];
    const visibleCount = document.getElementById('faq-visible-count');
    const noResults = document.getElementById('faq-no-results');
    const expandAll = document.getElementById('faq-expand-all');
    const collapseAll = document.getElementById('faq-collapse-all');

    let activeCategory = 'all';

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      let shown = 0;

      items.forEach((item) => {
        const category = item.closest('.faq-group')?.getAttribute('data-category') || '';
        const question = item.getAttribute('data-question') || '';
        const answer = item.getAttribute('data-answer') || '';
        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesSearch = !q || question.includes(q) || answer.includes(q);
        const visible = matchesCategory && matchesSearch;
        item.style.display = visible ? '' : 'none';
        if (visible) shown++;
      });

      groups.forEach((group) => {
        const visibleItems = Array.from(group.querySelectorAll('.faq-item')).filter(
          (el) => (el as HTMLElement).style.display !== 'none'
        );
        group.style.display = visibleItems.length ? '' : 'none';
      });

      if (visibleCount) visibleCount.textContent = String(shown);
      noResults?.classList.toggle('hidden', shown !== 0);
    }

    let searchDebounce;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(applyFilters, 180);
    });

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.getAttribute('data-category') || 'all';
        filters.forEach((b) => {
          b.classList.remove('active', 'bg-[#00529B]', 'text-white', 'shadow-md', 'border-[#00529B]');
          b.classList.add('bg-white', 'text-gray-700', 'border-2', 'border-gray-200', 'shadow-sm');
        });
        btn.classList.add('active', 'bg-[#00529B]', 'text-white', 'shadow-md');
        btn.classList.remove('bg-white', 'text-gray-700', 'border-gray-200', 'shadow-sm');

        applyFilters();

        const firstVisible = groups.find((g) => g.style.display !== 'none');
        if (firstVisible && activeCategory !== 'all') {
          const top = firstVisible.getBoundingClientRect().top + window.pageYOffset - 100;
          window.scrollTo({ top, behavior: 'smooth' });
        } else if (activeCategory === 'all') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });

    expandAll?.addEventListener('click', () => {
      items.forEach((item) => {
        if (item.style.display !== 'none') item.open = true;
      });
    });

    collapseAll?.addEventListener('click', () => {
      items.forEach((item) => (item.open = false));
    });
  </script>
</Layout>
